<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="never"><info><author><name>Julian Onions</name><email>julian.onions@gmail.com</email></author><contributor><name>Rintze Zelle</name><uri>http://twitter.com/rintzezelle</uri></contributor><contributor><name>Richard Karnesky</name><email>karnesky+zotero@gmail.com</email><uri>http://arc.nucapt.northwestern.edu/Richard_Karnesky</uri></contributor><contributor><name>Charles Parnot</name><email>charles.parnot@gmail.com</email><uri>http://twitter.com/cparnot</uri></contributor><contributor><name>Patrick O'Brien</name></contributor><category citation-format="numeric"/><category field="biology"/><id>http://www.zotero.org/styles/american-society-for-microbiology</id><link href="http://www.zotero.org/styles/american-society-for-microbiology" rel="self"/><link href="https://journals.asm.org/references" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>Style for all American Society for Microbiology journals.</summary><title>American Society for Microbiology</title><title-short>ASM</title-short><updated>2022-01-13T16:47:12+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout prefix="(" suffix=")" delimiter=", "><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" second-field-align="flush" line-spacing="2" entry-spacing="1" subsequent-author-substitute-rule="complete-all"><layout suffix="."><text variable="citation-number" form="long" suffix=". " quotes="false" strip-periods="false"/><text macro="author" quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/><text macro="title" prefix=" " quotes="false" strip-periods="false"/><text macro="chapter-specifics" quotes="false" strip-periods="false"/><text macro="patent-specifics" quotes="false" strip-periods="false"/><text macro="container-title" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/><text macro="locators" quotes="false" strip-periods="false"/></layout></bibliography><macro name="author"><names variable="author" suffix="."><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/></names></macro><macro name="issued"><group prefix=" " suffix="."><choose><if type="patent" match="all"><date variable="issued"><date-part name="month" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></if><else><date variable="issued"><date-part name="year" strip-periods="false"/></date></else></choose></group></macro><macro name="chapter-specifics"><choose><if type="chapter paper-conference" match="any"><label variable="page" form="short" plural="never" prefix=", " suffix=" " strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/><text term="in" form="long" plural="false" font-style="italic" prefix=". " suffix=" " quotes="false" strip-periods="false" text-case="capitalize-first"/><names variable="editor" delimiter=", " suffix=", "><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all"/><label form="short" plural="contextual" prefix=" (" suffix=")" strip-periods="false"/></names></if></choose></macro><macro name="patent-specifics"><text variable="number" form="long" prefix=". " quotes="false" strip-periods="false"/></macro><macro name="container-title"><choose><if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any"><text variable="container-title" form="long" quotes="false" strip-periods="false"/></if><else><text variable="container-title" form="short" prefix=". " quotes="false" strip-periods="true"/></else></choose></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group prefix=", " delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><macro name="publisher"><choose><if type="article-journal article-magazine" match="none"><group prefix=". " delimiter=". "><choose><if type="book" match="none"><text variable="genre" form="long" quotes="false" strip-periods="false"/></if></choose><group delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></group></group></if></choose></macro><macro name="locators"><choose><if type="article-journal" match="all"><choose><if variable="volume page" match="none"><text variable="DOI" form="long" prefix=" https://doi.org/" quotes="false" strip-periods="false"/></if><else><group prefix=" " delimiter=":"><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></else></choose></if><else-if type="article" match="all"><text variable="DOI" form="long" prefix=" https://doi.org/" quotes="false" strip-periods="false"/></else-if><else-if type="book webpage post post-weblog" match="any"><group prefix=". " delimiter=". "><text variable="URL" form="long" quotes="false" strip-periods="false"/><group delimiter=" "><text term="retrieved" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><date variable="accessed"><date-part name="day" strip-periods="false"/><date-part name="month" prefix=" " strip-periods="false"/><date-part name="year" prefix=" " strip-periods="false"/></date></group></group></else-if></choose></macro><macro name="title"><group delimiter=" "><text variable="title" form="long" quotes="false" strip-periods="false"/><text variable="version" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group></macro></style>