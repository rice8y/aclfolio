<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="sort-only"><info><author><name>Richard Karnesky</name><email>karnesky+zotero@gmail.com</email><uri>http://arc.nucapt.northwestern.edu/Richard_Karnesky</uri></author><contributor><name>Patrick O'Brien</name></contributor><category citation-format="numeric"/><category field="engineering"/><id>http://www.zotero.org/styles/american-society-of-mechanical-engineers</id><link href="http://www.zotero.org/styles/american-society-of-mechanical-engineers" rel="self"/><link href="http://www.zotero.org/styles/ieee" rel="template"/><link href="https://www.asme.org/publications-submissions/journals/information-for-authors/journal-guidelines/references" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>A style for the ASME's 23 journals</summary><title>American Society of Mechanical Engineers</title><title-short>ASME</title-short><updated>2023-11-03T07:25:27+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout prefix="[" suffix="]" delimiter=","><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" second-field-align="flush" line-spacing="1" entry-spacing="0" subsequent-author-substitute-rule="complete-all"><layout suffix="."><text variable="citation-number" form="long" prefix="[" suffix="]" quotes="false" strip-periods="false"/><text macro="author" suffix=", " quotes="false" strip-periods="false"/><date variable="issued" suffix=", "><date-part name="year" strip-periods="false"/></date><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group delimiter=", "><text macro="title" font-style="italic" quotes="false" strip-periods="false"/><text variable="number" form="long" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></if><else-if type="chapter paper-conference" match="any"><group delimiter=", "><text macro="title" quotes="false" strip-periods="false"/><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/><text macro="editor" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/><text macro="page" quotes="false" strip-periods="false"/></group></else-if><else-if type="thesis" match="all"><group delimiter=", "><text macro="title" quotes="false" strip-periods="false"/><text variable="genre" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group></else-if><else><group delimiter=", "><text macro="title" quotes="false" strip-periods="false"/><text variable="container-title" form="short" quotes="false" strip-periods="false"/><group><text variable="volume" form="long" font-weight="bold" quotes="false" strip-periods="false"/><text variable="issue" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group><text macro="page" quotes="false" strip-periods="false"/></group></else></choose><text macro="access" prefix=". " quotes="false" strip-periods="false"/></layout></bibliography><macro name="author"><names variable="author"><name delimiter=", " and="text" delimiter-precedes-last="always" initialize-with=". " name-as-sort-order="all" sort-separator=", "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="editor"><names variable="editor"><name delimiter=", " and="text" delimiter-precedes-last="always" initialize-with="."/><label form="short" plural="contextual" prefix=", " strip-periods="false"/></names></macro><macro name="title"><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="long" quotes="false" strip-periods="false" text-case="title"/></if><else><text variable="title" form="long" quotes="true" strip-periods="false" text-case="title"/></else></choose></macro><macro name="publisher"><group prefix=" " delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="access"><choose><if variable="DOI" match="any"><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></if><else-if variable="URL" match="any"><group delimiter=". "><text value="[Online]" quotes="false" strip-periods="false"/><text variable="URL" form="long" prefix="Available: " quotes="false" strip-periods="false"/><group prefix="[" suffix="]"><date variable="accessed" prefix="Accessed: "><date-part name="day" form="numeric-leading-zeros" suffix="-" strip-periods="false"/><date-part name="month" form="short" suffix="-" strip-periods="true"/><date-part name="year" form="long" strip-periods="false"/></date></group></group></else-if></choose></macro><macro name="page"><group><label variable="page" form="short" plural="contextual" suffix=" " strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></macro></style>