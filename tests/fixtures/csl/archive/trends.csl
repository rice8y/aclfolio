<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="sort-only"><info><author><name>Adam Zeilinger</name><email>arzeilinger@gmail.com</email></author><contributor><name>Julian Onions</name><email>julian.onions@gmail.com</email></contributor><contributor><name>Rintze Zelle</name><uri>http://twitter.com/rintzezelle</uri></contributor><contributor><name>Stephen Frank</name><uri>http://www.zotero.org/sfrank</uri></contributor><contributor><name>Michael Berkowitz</name><email>mberkowi@gmu.edu</email></contributor><contributor><name>Thomas Kluyver</name><email>takowl@gmail.com</email></contributor><contributor><name>Patrick O'Brien</name></contributor><category citation-format="numeric"/><category field="biology"/><category field="medicine"/><id>http://www.zotero.org/styles/trends-journals</id><link href="http://www.zotero.org/styles/trends-journals" rel="self"/><link href="http://www.cell.com/trends/ecology-evolution/authors" rel="documentation"/><link href="http://www.cell.com/cellpress/trends" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>Style for the "Trends" journals by Cell Press</summary><title>Trends journals</title><updated>2022-09-12T12:37:15+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout prefix="[" suffix="]" delimiter=","><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" second-field-align="flush" line-spacing="1" entry-spacing="0" subsequent-author-substitute-rule="complete-all" et-al-min="3" et-al-use-first="1"><layout><text variable="citation-number" form="long" suffix="." quotes="false" strip-periods="false"/><group delimiter=" "><text macro="author" quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/><text macro="title" quotes="false" strip-periods="false"/></group><choose><if type="article-journal" match="all"><group prefix=". " delimiter=" "><text variable="container-title" form="short" font-style="italic" quotes="false" strip-periods="false"/><choose><if variable="volume" match="all"><group delimiter=", "><text macro="locators" quotes="false" strip-periods="false"/><text macro="page" quotes="false" strip-periods="false"/></group></if><else-if variable="DOI" match="all"><text variable="DOI" form="long" prefix="DOI: " quotes="false" strip-periods="false"/></else-if><else-if variable="URL" match="all"><text term="at" form="long" plural="false" quotes="false" strip-periods="false"/><text variable="URL" form="long" prefix=" &lt;" suffix="&gt;" quotes="false" strip-periods="false"/></else-if></choose></group></if><else-if type="paper-conference" match="all"><group prefix=". " delimiter=", "><text macro="event" quotes="false" strip-periods="false"/><text macro="locators" quotes="false" strip-periods="false"/><text macro="page" quotes="false" strip-periods="false"/></group></else-if><else-if type="thesis" match="all"><group prefix=". " delimiter=", "><text variable="genre" form="long" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></else-if><else-if type="webpage post post-weblog" match="any"><text variable="container-title" form="long" font-style="italic" prefix=". " suffix=". " quotes="false" strip-periods="false"/><text macro="access" quotes="false" strip-periods="false"/></else-if><else-if type="patent" match="all"><text variable="number" form="long" prefix=", " quotes="false" strip-periods="false"/></else-if><else-if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group prefix=", " delimiter=", "><text macro="locators" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></else-if><else-if type="article-journal article-magazine article-newspaper broadcast interview manuscript map patent personal_communication song speech thesis webpage" match="any"><group delimiter=", "><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="locators" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/><text macro="page" quotes="false" strip-periods="false"/></group></else-if><else-if type="chapter paper-conference" match="any"><group delimiter=", "><group prefix=". " delimiter=" "><text term="in" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="locators" quotes="false" strip-periods="false"/><text macro="editor" quotes="false" strip-periods="false"/></group><text macro="page" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></else-if><else><group delimiter=", "><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="locators" quotes="false" strip-periods="false"/></group><group delimiter=", "><text macro="publisher" quotes="false" strip-periods="false"/><text macro="page" quotes="false" strip-periods="false"/></group></else></choose></layout></bibliography><macro name="edition"><choose><if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal" prefix="("/><text term="edition" form="short" plural="false" suffix="n) " quotes="false" strip-periods="true"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false" text-case="capitalize-first"/></else></choose></if></choose></macro><macro name="issued"><date variable="issued" form="text" date-parts="year" prefix="(" suffix=")"/></macro><macro name="author"><names variable="author"><name delimiter=", " and="text" initialize-with="." name-as-sort-order="all" sort-separator=", "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/><et-al term="et al" font-style="italic"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="editor"><names variable="editor" prefix="(" suffix=")"><name delimiter=", " and="text" initialize-with=". " name-as-sort-order="all" sort-separator=", "/><label form="short" plural="contextual" prefix=", " strip-periods="true"/></names></macro><macro name="locators"><group delimiter=", "><text macro="edition" prefix="(" suffix=")" quotes="false" strip-periods="false"/><group delimiter=" "><number variable="volume" form="numeric"/></group><group delimiter=" "><number variable="number-of-volumes" form="numeric"/><text term="volume" form="short" plural="true" quotes="false" strip-periods="false"/></group></group></macro><macro name="title"><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false"/></if><else><text variable="title" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="publisher"><choose><if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any"><text variable="publisher" form="long" quotes="false" strip-periods="false"/></if><else><text variable="publisher" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="event"><choose><if type="paper-conference" match="all"><choose><if variable="container-title" match="all"><group delimiter=", "><text variable="container-title" form="long" font-style="italic" prefix="in " quotes="false" strip-periods="false"/><text variable="event-place" form="long" quotes="false" strip-periods="false"/></group></if><else><group delimiter=", "><text variable="event" form="long" prefix="presented at the " quotes="false" strip-periods="false"/><text variable="event-place" form="long" quotes="false" strip-periods="false"/></group></else></choose></if></choose></macro><macro name="access"><choose><if type="webpage" match="all"><group delimiter=". "><text value="[Online]" quotes="false" strip-periods="false"/><text variable="URL" form="long" prefix="Available: " quotes="false" strip-periods="false"/><group prefix="[" suffix="]"><date variable="accessed" prefix="Accessed: "><date-part name="day" form="numeric-leading-zeros" suffix="-" strip-periods="false"/><date-part name="month" form="short" suffix="-" strip-periods="true"/><date-part name="year" form="long" strip-periods="false"/></date></group></group></if></choose></macro><macro name="page"><choose><if type="chapter paper-conference" match="any"><group delimiter=" "><label variable="page" form="short" plural="always" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></if><else><text variable="page" form="long" quotes="false" strip-periods="false"/></else></choose></macro></style>