<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" page-range-format="minimal" demote-non-dropping-particle="sort-only"><info><author><name>Richard Karnesky</name><email>karnesky+zotero@gmail.com</email><uri>http://arc.nucapt.northwestern.edu/Richard_Karnesky</uri></author><category citation-format="numeric"/><category field="generic-base"/><id>http://www.zotero.org/styles/elsevier-vancouver</id><link href="http://www.zotero.org/styles/elsevier-vancouver" rel="self"/><link href="http://www.elsevier.com/journals/energy/0360-5442/guide-for-authors#68000" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>A style for some Elsevier journals, resembles Vancouver style</summary><title>Elsevier - Vancouver</title><updated>2019-10-15T22:06:38+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout prefix="[" suffix="]" delimiter=","><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" second-field-align="flush" line-spacing="1" entry-spacing="0" subsequent-author-substitute-rule="complete-all" et-al-min="7" et-al-use-first="6"><layout suffix="."><text variable="citation-number" form="long" prefix="[" suffix="]" quotes="false" strip-periods="false"/><text macro="author" suffix=". " quotes="false" strip-periods="false"/><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group delimiter=". "><text variable="title" form="long" quotes="false" strip-periods="false"/><text variable="volume" form="long" prefix="vol. " quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></if><else-if type="chapter paper-conference" match="any"><group delimiter=", "><group delimiter=". "><text variable="title" form="long" quotes="false" strip-periods="false"/><group><text term="in" form="long" plural="false" suffix=": " quotes="false" strip-periods="false" text-case="sentence"/><text macro="editor" quotes="false" strip-periods="false"/></group><group delimiter=", "><text variable="container-title" form="short" quotes="false" strip-periods="false"/><text variable="volume" form="long" prefix="vol. " quotes="false" strip-periods="false"/></group><text macro="edition" quotes="false" strip-periods="false"/></group><text macro="publisher" quotes="false" strip-periods="false"/><group delimiter=" "><label variable="page" form="short" plural="never" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></else-if><else-if type="patent" match="all"><group delimiter=", "><group delimiter=". "><text variable="title" form="long" quotes="false" strip-periods="false"/><text variable="number" form="long" quotes="false" strip-periods="false"/></group><text macro="year-date" quotes="false" strip-periods="false"/></group></else-if><else-if type="thesis" match="all"><group delimiter=". "><text variable="title" form="long" quotes="false" strip-periods="false"/><text variable="genre" form="long" quotes="false" strip-periods="false"/><group delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text macro="year-date" quotes="false" strip-periods="false"/></group></group></else-if><else><group delimiter=":"><group delimiter=" "><group delimiter=". "><text variable="title" form="long" quotes="false" strip-periods="false"/><text variable="container-title" form="short" quotes="false" strip-periods="true" text-case="title"/></group><group delimiter=";"><text macro="year-date" quotes="false" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/></group></group><text variable="page" form="short" quotes="false" strip-periods="false"/></group></else></choose><text macro="access" prefix=". " quotes="false" strip-periods="false"/></layout></bibliography><macro name="author"><names variable="author"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " strip-periods="false"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="editor"><names variable="editor"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " suffix="." strip-periods="false"/></names></macro><macro name="year-date"><choose><if variable="issued" match="all"><date variable="issued"><date-part name="year" strip-periods="false"/></date></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="publisher"><text variable="publisher-place" form="long" suffix=": " quotes="false" strip-periods="false" text-case="title"/><text variable="publisher" form="long" suffix="; " quotes="false" strip-periods="false"/><text macro="year-date" quotes="false" strip-periods="false"/></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="access"><choose><if variable="DOI" match="all"><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></if><else-if type="webpage post-weblog" match="any"><choose><if variable="URL" match="all"><text variable="URL" form="long" quotes="false" strip-periods="false"/><group prefix=" (" suffix=")" delimiter=" "><text term="accessed" form="long" plural="false" quotes="false" strip-periods="false"/><date variable="accessed" form="text"/></group></if></choose></else-if></choose></macro></style>