<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="sort-only"><info><author><name>Julian Onions</name><email>julian.onions@gmail.com</email></author><contributor><name>Patrick O'Brien</name><email>obrienpat86@gmail.com</email></contributor><contributor><name>Sebastian Karcher</name></contributor><category citation-format="author-date"/><category field="science"/><id>http://www.zotero.org/styles/council-of-science-editors-author-date</id><link href="http://www.zotero.org/styles/council-of-science-editors-author-date" rel="self"/><link href="http://library.osu.edu/sites/guides/csegd.php" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>The Council of Science Editors style, Name-Year system: author-date in text, sorted in alphabetical order by author.</summary><title>Council of Science Editors, Name-Year (author-date)</title><title-short>CSE N-Y</title-short><updated>2017-06-19T16:27:46+00:00</updated></info><citation disambiguate-add-givenname="true" givenname-disambiguation-rule="by-cite" disambiguate-add-names="true" disambiguate-add-year-suffix="true" near-note-distance="5" et-al-min="3" et-al-use-first="1"><sort><key macro="year-date" sort="ascending"/><key macro="author-short" sort="ascending"/></sort><layout prefix="(" suffix=")" delimiter="; "><group delimiter=" "><text macro="author-short" quotes="false" strip-periods="false"/><text macro="date" quotes="false" strip-periods="false"/></group><text variable="locator" form="long" prefix=": " quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" line-spacing="1" entry-spacing="1" subsequent-author-substitute-rule="complete-all" et-al-min="11" et-al-use-first="10"><sort><key macro="author" sort="ascending"/><key macro="year-date" sort="ascending"/></sort><layout suffix="."><group suffix="." delimiter=". "><text macro="author" quotes="false" strip-periods="false"/><text macro="date" quotes="false" strip-periods="false"/><text macro="title" quotes="false" strip-periods="false"/></group><group suffix="."><choose><if type="bill book graphic legal_case legislation motion_picture report song thesis" match="any"><group prefix=" " suffix="." delimiter=" "><text macro="edition" quotes="false" strip-periods="false"/><text macro="editor" quotes="false" strip-periods="false"/></group><text macro="publisher" prefix=" " quotes="false" strip-periods="false"/><text macro="collection" prefix=" " quotes="false" strip-periods="false"/></if><else-if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any"><group prefix=" " delimiter=" "><group delimiter=" "><text term="in" form="long" plural="false" suffix=":" quotes="false" strip-periods="false" text-case="capitalize-first"/><text macro="editor" quotes="false" strip-periods="false"/><text variable="container-title" form="long" suffix="." quotes="false" strip-periods="false"/></group><text variable="volume" form="long" prefix="Vol. " suffix="." quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><group suffix="." delimiter=". "><text macro="publisher" quotes="false" strip-periods="false"/><text macro="collection" prefix=" " quotes="false" strip-periods="false"/><text macro="pages" quotes="false" strip-periods="false"/></group></group></else-if><else-if type="review review-book" match="any"><text macro="editor" prefix=" " suffix="." quotes="false" strip-periods="false"/><group prefix=" "><text macro="review" suffix="." quotes="false" strip-periods="false"/><group prefix=" "><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="issue" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group><text variable="page" form="long" prefix=":" quotes="false" strip-periods="false"/></group></else-if><else><text macro="editor" prefix=" " suffix="." quotes="false" strip-periods="false"/><group prefix=" "><text variable="container-title" form="short" suffix="." quotes="false" strip-periods="true"/><text variable="volume" form="long" prefix=" " quotes="false" strip-periods="false"/><text variable="issue" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/><text variable="page" form="long" prefix=":" quotes="false" strip-periods="false"/></group><text variable="DOI" form="long" prefix=". doi:" quotes="false" strip-periods="false"/></else></choose></group><text macro="access" prefix=" " quotes="false" strip-periods="false"/></layout></bibliography><macro name="editor"><names variable="editor translator" delimiter="; " suffix="."><name delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " strip-periods="false"/></names></macro><macro name="author"><names variable="author" delimiter="; "><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " strip-periods="true"/><substitute><names variable="editor translator"/><text variable="title" form="long" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="author-short"><names variable="author"><name delimiter=", " form="short" and="text" initialize-with="."/><substitute><names variable="editor"/><names variable="translator"/><text variable="title" form="short" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="review"><group delimiter=". "><text variable="reviewed-title" form="long" quotes="false" strip-periods="false"/><text variable="container-title" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="access"><choose><if variable="URL" match="any"><group delimiter=". "><group prefix=" [" suffix="]" delimiter=" "><text term="accessed" form="long" plural="false" quotes="false" strip-periods="false"/><date variable="accessed" delimiter=" "><date-part name="year" strip-periods="false"/><date-part name="month" form="short" strip-periods="true"/><date-part name="day" strip-periods="false"/></date></group><text variable="URL" form="long" quotes="false" strip-periods="false"/></group></if></choose></macro><macro name="title"><group delimiter=" "><text variable="title" form="long" quotes="false" strip-periods="false"/><choose><if type="thesis" match="any"><text variable="genre" form="long" prefix="[" suffix="]" quotes="false" strip-periods="false"/></if></choose></group></macro><macro name="publisher"><group delimiter=": "><choose><if type="thesis" match="all"><text variable="publisher-place" form="long" prefix="[" suffix="]" quotes="false" strip-periods="false"/></if><else><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></else></choose><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="pages"><group delimiter="; "><group><label variable="page" form="short" plural="never" suffix=" " strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group><group><text variable="number-of-pages" form="long" quotes="false" strip-periods="false"/><choose><if is-numeric="number-of-pages" match="all"><label variable="number-of-pages" form="short" plural="never" prefix=" " strip-periods="false"/></if></choose></group></group></macro><macro name="year-date"><date variable="issued" form="numeric" date-parts="year"/></macro><macro name="date"><group delimiter=" "><text macro="year-date" quotes="false" strip-periods="false"/><choose><if type="patent article-newspaper webpage" match="any"><date variable="issued" delimiter=" "><date-part name="month" form="short" strip-periods="true"/><date-part name="day" strip-periods="false"/></date></if><else-if type="article-journal article-magazine" match="any"><choose><if variable="volume issue" match="none"><date variable="issued" delimiter=" "><date-part name="month" form="short" strip-periods="true"/><date-part name="day" strip-periods="false"/></date></if></choose></else-if></choose></group></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><macro name="collection"><choose><if type="report" match="all"><group prefix=" " suffix="." delimiter=" "><text variable="collection-title" form="long" quotes="false" strip-periods="false"/><text variable="number" form="long" prefix=" Report No.: " quotes="false" strip-periods="false"/></group></if><else><group prefix=" (" suffix=")." delimiter=" "><names variable="collection-editor" suffix=". "><name delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " strip-periods="false"/></names><text variable="collection-title" form="long" quotes="false" strip-periods="false"/></group></else></choose></macro><locale xml:lang="en"><terms><term name="editor-translator" form="long"><single>editor and translator</single><multiple>editors and translators</multiple></term><term name="collection-editor" form="long"><single>editor</single><multiple>editors</multiple></term></terms></locale></style>