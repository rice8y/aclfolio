<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-GB" version="1.0" class="note" initialize-with-hyphen="true" page-range-format="chicago-15" demote-non-dropping-particle="sort-only"><info><author><name>Rintze Zelle</name><uri>http://twitter.com/rintzezelle</uri></author><contributor><name>Sebastian Karcher</name></contributor><contributor><name>Andrew Dunning</name><uri>https://orcid.org/0000-0003-0464-5036</uri></contributor><contributor><name>Patrick O'Brien</name></contributor><category citation-format="note"/><category field="generic-base"/><id>http://www.zotero.org/styles/modern-humanities-research-association</id><link href="http://www.zotero.org/styles/modern-humanities-research-association" rel="self"/><link href="http://www.mhra.org.uk/Publications/Books/StyleGuide/download.shtml" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>MHRA format with full notes and bibliography</summary><title>Modern Humanities Research Association 4th edition (note with bibliography)</title><title-short>MHRA</title-short><updated>2024-10-30T15:33:25+00:00</updated></info><citation disambiguate-add-givenname="true" givenname-disambiguation-rule="by-cite" disambiguate-add-names="true" disambiguate-add-year-suffix="false" near-note-distance="5" et-al-min="4" et-al-use-first="1"><layout suffix="." delimiter="; "><choose><if position="subsequent" match="all"><group delimiter=", "><text macro="contributors-short" quotes="false" strip-periods="false"/><text macro="title-subsequent" quotes="false" strip-periods="false"/><text macro="locators-specific-note" quotes="false" strip-periods="false"/></group><text macro="point-locators-subsequent" quotes="false" strip-periods="false"/></if><else><group delimiter=", "><text macro="contributors-note" quotes="false" strip-periods="false"/><text macro="title-note" quotes="false" strip-periods="false"/><text macro="secondary-contributors-note" quotes="false" strip-periods="false"/><text macro="container-title-note" quotes="false" strip-periods="false"/><text macro="container-contributors-note" quotes="false" strip-periods="false"/><text macro="collection-title" quotes="false" strip-periods="false"/><text macro="locators-note" quotes="false" strip-periods="false"/></group><text macro="issue-note" quotes="false" strip-periods="false"/><text macro="locators-specific-note" prefix=", " quotes="false" strip-periods="false"/><text macro="locators-newspaper" prefix=", " quotes="false" strip-periods="false"/><text macro="point-locators" quotes="false" strip-periods="false"/><text macro="access-note" quotes="false" strip-periods="false"/></else></choose></layout></citation><bibliography hanging-indent="true" line-spacing="1" entry-spacing="1" subsequent-author-substitute="———" subsequent-author-substitute-rule="complete-all" et-al-min="7" et-al-use-first="6"><sort><key macro="author" sort="ascending"/><key variable="title" sort="ascending"/></sort><layout><group delimiter=", "><text macro="author" quotes="false" strip-periods="false"/><text macro="title-note" quotes="false" strip-periods="false"/><text macro="secondary-contributors-note" quotes="false" strip-periods="false"/><text macro="container-title-note" quotes="false" strip-periods="false"/><text macro="container-contributors-note" quotes="false" strip-periods="false"/><text macro="collection-title" quotes="false" strip-periods="false"/><text macro="volume" quotes="false" strip-periods="false"/></group><text macro="issue-note" quotes="false" strip-periods="false"/><text macro="locators-specific-note" prefix=", " quotes="false" strip-periods="false"/><text macro="artwork" prefix=", " quotes="false" strip-periods="false"/><text macro="locators-newspaper" prefix=", " quotes="false" strip-periods="false"/><text macro="pages" quotes="false" strip-periods="false"/><text macro="access-note" quotes="false" strip-periods="false"/></layout></bibliography><macro name="author"><group delimiter=". "><names variable="author"><name delimiter=", " and="text" delimiter-precedes-last="always" name-as-sort-order="first" sort-separator=", "/><label form="short" plural="contextual" prefix=", " suffix="." strip-periods="false"/><substitute><names variable="editor"/><names variable="translator"/><text macro="title-note" quotes="false" strip-periods="false"/></substitute></names><text macro="recipient" quotes="false" strip-periods="false"/></group></macro><macro name="recipient"><group delimiter=" "><choose><if type="personal_communication" match="all"><choose><if variable="genre" match="all"><text variable="genre" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/></if><else><text term="letter" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/></else></choose></if></choose><text macro="recipient-note" quotes="false" strip-periods="false"/></group></macro><macro name="contributors-note"><names variable="author"><name delimiter=", " and="text" sort-separator=", "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/><substitute><text macro="title-note" quotes="false" strip-periods="false"/></substitute></names><text macro="recipient-note" quotes="false" strip-periods="false"/></macro><macro name="title-note"><choose><if variable="title" match="none"><text variable="genre" form="long" quotes="false" strip-periods="false"/></if><else-if type="bill book graphic legislation motion_picture report song" match="any"><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/><group prefix=", " delimiter=" "><text term="version" form="long" plural="false" quotes="false" strip-periods="false"/><text variable="version" form="long" quotes="false" strip-periods="false"/></group></else-if><else-if type="legal_case interview" match="any"><text variable="title" form="long" quotes="false" strip-periods="false"/></else-if><else-if variable="reviewed-author" match="all"><text variable="title" form="long" font-style="italic" prefix="review of " quotes="false" strip-periods="false"/></else-if><else><text variable="title" form="long" quotes="true" strip-periods="false" text-case="title"/></else></choose></macro><macro name="title-subsequent"><choose><if variable="title" match="none"><text macro="issued" quotes="false" strip-periods="false"/></if><else-if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="short" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></else-if><else><text variable="title" form="short" quotes="true" strip-periods="false" text-case="title"/></else></choose></macro><macro name="title-sort-substitute"><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="short" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></if><else><text variable="title" form="short" quotes="true" strip-periods="false" text-case="title"/></else></choose></macro><macro name="editor-translator"><group delimiter=", "><group delimiter=" "><choose><if variable="container-author reviewed-author" match="any"><group><names variable="container-author reviewed-author"><label form="verb-short" plural="contextual" suffix=" " text-case="lowercase" strip-periods="false"/><name delimiter=", " and="text"/></names></group></if></choose></group><names variable="editor translator director" delimiter=", "><label form="verb-short" plural="contextual" suffix=" " text-case="lowercase" strip-periods="false"/><name delimiter=", " and="text"/></names></group></macro><macro name="secondary-contributors-note"><choose><if type="chapter paper-conference" match="none"><text macro="editor-translator" quotes="false" strip-periods="false"/></if></choose></macro><macro name="container-contributors-note"><choose><if type="chapter paper-conference" match="any"><text macro="editor-translator" quotes="false" strip-periods="false"/></if></choose></macro><macro name="collection-title"><group delimiter=", "><choose><if type="article-journal" match="all"><text variable="collection-title" form="long" quotes="false" strip-periods="false"/><text variable="collection-number" form="long" quotes="false" strip-periods="false"/></if><else><text variable="collection-title" form="long" quotes="false" strip-periods="false" text-case="title"/><text variable="collection-number" form="long" quotes="false" strip-periods="false"/></else></choose></group></macro><macro name="locators-note"><choose><if type="article-journal" match="all"><group delimiter="."><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="issue" form="long" quotes="false" strip-periods="false"/></group></if><else-if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any"><group delimiter=", "><text macro="edition-note" quotes="false" strip-periods="false"/><group><number variable="number-of-volumes" form="numeric"/><text term="volume" form="short" plural="true" prefix=" " quotes="false" strip-periods="false"/></group></group></else-if></choose></macro><macro name="volume"><choose><if type="article-journal" match="all"><group delimiter="."><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="issue" form="long" quotes="false" strip-periods="false"/></group></if><else-if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any"><group delimiter=", "><text macro="edition-note" quotes="false" strip-periods="false"/><group><number variable="number-of-volumes" form="numeric"/><text term="volume" form="short" plural="true" prefix=" " quotes="false" strip-periods="false"/></group></group></else-if></choose></macro><macro name="issue-note"><choose><if type="article-journal" match="all"><choose><if variable="volume" match="all"><text macro="issued" prefix=" (" suffix=")" quotes="false" strip-periods="false"/></if><else><text macro="issued" prefix=", " quotes="false" strip-periods="false"/></else></choose></if><else-if variable="publisher-place publisher" match="any"><group prefix=" (" suffix=")" delimiter=", "><group delimiter=" "><choose><if variable="title" match="none"/><else-if type="thesis speech" match="any"><text variable="genre" form="long" prefix="unpublished " quotes="false" strip-periods="false"/></else-if></choose><text macro="event" quotes="false" strip-periods="false"/></group><text macro="publisher" quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/></group></else-if><else><text macro="issued" prefix=", " quotes="false" strip-periods="false"/></else></choose></macro><macro name="locators-specific-note"><choose><if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any"><choose><if is-numeric="volume" match="all"><number variable="volume" form="roman" font-variant="small-caps"/></if><else><text variable="volume" form="long" font-variant="small-caps" quotes="false" strip-periods="false"/></else></choose></if></choose></macro><macro name="container-title-note"><choose><if type="chapter paper-conference" match="any"><text term="in" form="long" plural="false" suffix=" " quotes="false" strip-periods="false"/></if></choose><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></macro><macro name="edition-note"><choose><if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" quotes="false" strip-periods="false"/></else></choose></if></choose></macro><macro name="recipient-note"><names variable="recipient" delimiter=", "><label form="verb" plural="contextual" prefix=" " suffix=" " strip-periods="false"/><name delimiter=", " and="text"/></names></macro><macro name="recipient-short"><names variable="recipient"><label form="verb" plural="contextual" prefix=" " suffix=" " strip-periods="false"/><name delimiter=", " form="short" and="text"/></names></macro><macro name="contributors-short"><names variable="author"><name delimiter=", " form="short" and="text" sort-separator=", "/><substitute><names variable="editor"/><names variable="translator"/><text macro="title-sort-substitute" quotes="false" strip-periods="false"/></substitute></names><text macro="recipient-short" quotes="false" strip-periods="false"/></macro><macro name="locators-newspaper"><choose><if type="article-newspaper" match="all"><group delimiter=", "><group delimiter=" "><text variable="edition" form="long" quotes="false" strip-periods="false"/><text term="edition" form="long" plural="false" quotes="false" strip-periods="false"/></group><group><text term="section" form="long" plural="false" suffix=" " quotes="false" strip-periods="false"/><text variable="section" form="long" quotes="false" strip-periods="false"/></group></group></if></choose></macro><macro name="event"><group><text term="presented at" form="long" plural="false" suffix=" " quotes="false" strip-periods="false"/><text variable="event" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="publisher"><choose><if type="thesis" match="all"><text variable="publisher" form="long" quotes="false" strip-periods="false"/></if><else><text variable="publisher" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="issued"><choose><if type="report article-newspaper article-magazine personal_communication" match="any"><date variable="issued"><date-part name="day" suffix=" " strip-periods="false"/><date-part name="month" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></if><else><date variable="issued"><date-part name="year" strip-periods="false"/></date></else></choose></macro><macro name="pages"><choose><if type="article-journal" match="all"><group prefix=", " delimiter=" "><label variable="page" form="short" plural="contextual" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></if><else><choose><if variable="volume" match="all"><text variable="page" form="long" prefix=", " quotes="false" strip-periods="false"/></if><else><label variable="page" form="short" plural="contextual" prefix=", " suffix=" " strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></else></choose></else></choose></macro><macro name="point-locators"><text macro="pages" quotes="false" strip-periods="false"/><choose><if variable="page" match="all"><group prefix=" (" suffix=")"><label variable="locator" form="short" plural="contextual" suffix=" " strip-periods="false"/><text variable="locator" form="long" quotes="false" strip-periods="false"/></group></if><else><label variable="locator" form="short" plural="contextual" prefix=", " suffix=" " strip-periods="false"/><text variable="locator" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="point-locators-subsequent"><label variable="locator" form="short" plural="contextual" prefix=", " suffix=" " strip-periods="false"/><text variable="locator" form="long" quotes="false" strip-periods="false"/></macro><macro name="archive-note"><group delimiter=", "><text variable="archive-place" form="long" quotes="false" strip-periods="false"/><text variable="archive" form="long" quotes="false" strip-periods="false"/><text variable="archive_location" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="access-note"><group delimiter=", "><choose><if type="article-journal bill chapter legal_case legislation paper-conference" match="none"><text macro="archive-note" prefix=", " quotes="false" strip-periods="false"/></if></choose></group><choose><if variable="DOI" match="all"><text variable="DOI" form="long" prefix=", doi:" quotes="false" strip-periods="false"/></if><else><choose><if variable="URL" match="all"><text variable="URL" form="long" prefix=" &lt;" suffix="&gt;" quotes="false" strip-periods="false"/><group prefix=" [" suffix="]"><text term="accessed" form="long" plural="false" quotes="false" strip-periods="false"/><date variable="accessed"><date-part name="day" prefix=" " strip-periods="false"/><date-part name="month" prefix=" " strip-periods="false"/><date-part name="year" prefix=" " strip-periods="false"/></date></group></if></choose></else></choose></macro><macro name="artwork"><choose><if type="graphic" match="any"><group delimiter=", "><text variable="medium" form="long" quotes="false" strip-periods="false"/><text variable="dimensions" form="long" quotes="false" strip-periods="false"/></group></if></choose></macro><locale xml:lang="en"><terms><term name="et-al" form="long">and others</term><term name="editor" form="verb-short">ed. by</term><term name="edition" form="short">edn</term><term name="translator" form="verb-short">trans. by</term><term name="folio" form="long"><single>fol.</single><multiple>fols</multiple></term></terms></locale></style>