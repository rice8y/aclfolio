<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" initialize-with-hyphen="true" page-range-format="chicago-15" demote-non-dropping-particle="sort-only"><info><author><name>Julian Onions</name><email>julian.onions@gmail.com</email></author><contributor><name>Sebastian Karcher</name></contributor><contributor><name>Patrick O'Brien</name></contributor><contributor><name>Aaron Guerra</name></contributor><category citation-format="author-date"/><category field="political_science"/><id>http://www.zotero.org/styles/american-political-science-association</id><link href="http://www.zotero.org/styles/american-political-science-association" rel="self"/><link href="https://connect.apsanet.org/stylemanual/wp-content/uploads/sites/43/2023/12/Style-Manual-for-Political-Science-December-2023-Revision.pdf" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>The American Political Science Association style. Et al rules based on published APSR articles</summary><title>American Political Science Association</title><title-short>APSA</title-short><updated>2024-03-13T15:37:50+00:00</updated></info><citation disambiguate-add-givenname="true" givenname-disambiguation-rule="primary-name" disambiguate-add-names="true" disambiguate-add-year-suffix="true" collapse="year" near-note-distance="5" et-al-min="4" et-al-use-first="1"><sort><key macro="author-short" sort="ascending"/><key macro="year-date" sort="ascending"/></sort><layout prefix="(" suffix=")" delimiter="; "><group delimiter=", "><group delimiter=" "><text macro="author-short" quotes="false" strip-periods="false"/><text macro="year-date" quotes="false" strip-periods="false"/></group><text macro="locator" quotes="false" strip-periods="false"/></group></layout></citation><bibliography hanging-indent="true" line-spacing="1" entry-spacing="1" subsequent-author-substitute-rule="complete-all" et-al-min="10" et-al-use-first="7"><sort><key macro="author" sort="ascending"/><key macro="year-date" sort="ascending"/><key variable="title" sort="ascending"/></sort><layout suffix="."><text macro="author" suffix="." quotes="false" strip-periods="false"/><date variable="issued" prefix=" " suffix="."><date-part name="year" strip-periods="false"/></date><choose><if type="bill book graphic legal_case legislation manuscript motion_picture report song thesis" match="any"><text macro="legal_case" quotes="false" strip-periods="false"/><group prefix=" " delimiter=" "><text macro="title" suffix="." quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><text macro="editor" suffix="." quotes="false" strip-periods="false"/></group><text macro="publisher" prefix=" " suffix="." quotes="false" strip-periods="false"/></if><else-if type="chapter paper-conference" match="any"><text macro="title" prefix=" " suffix="." quotes="false" strip-periods="false"/><group prefix=" " delimiter=" "><text term="in" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="container-title" form="long" font-style="italic" suffix="," quotes="false" strip-periods="false" text-case="title"/><text variable="collection-title" form="long" suffix="," quotes="false" strip-periods="false"/><text macro="editor" suffix="." quotes="false" strip-periods="false"/><group suffix="."><text macro="publisher" quotes="false" strip-periods="false"/><text variable="page" form="long" prefix=", " quotes="false" strip-periods="false"/></group></group></else-if><else><group prefix=" " suffix="." delimiter=" "><text macro="title" quotes="false" strip-periods="false"/><text macro="editor" quotes="false" strip-periods="false"/></group><choose><if type="speech" match="all"><group prefix=" " suffix="." delimiter=" "><text term="presented at" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><group delimiter=", "><text variable="event" form="long" quotes="false" strip-periods="false"/><text variable="event-place" form="long" quotes="false" strip-periods="false"/></group></group></if></choose><group prefix=" " suffix="."><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><group prefix=" "><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="issue" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group><text variable="page" form="long" prefix=": " quotes="false" strip-periods="false"/></group></else></choose><text macro="access" prefix=" " suffix="." quotes="false" strip-periods="false"/></layout></bibliography><macro name="editor"><names variable="editor" delimiter=", "><label form="short" plural="contextual" suffix=" " text-case="lowercase" strip-periods="false"/><name delimiter=", " and="text"/></names></macro><macro name="author"><names variable="author"><name delimiter=", " and="text" delimiter-precedes-last="always" name-as-sort-order="first" sort-separator=", "/><label form="short" plural="contextual" prefix=", " text-case="lowercase" strip-periods="false"/><substitute><names variable="editor"/><text macro="title" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="author-short"><names variable="author"><name delimiter=", " form="short" and="text" initialize-with=". " sort-separator=", "/><substitute><names variable="editor"/><names variable="translator"/><text variable="title" form="short" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="access"><choose><if type="legal_case" match="none"><choose><if variable="DOI" match="all"><text variable="DOI" form="long" prefix="doi:" quotes="false" strip-periods="false"/></if><else-if variable="URL" match="any"><group delimiter=" "><text variable="URL" form="long" quotes="false" strip-periods="false"/><group prefix="(" suffix=")"><date variable="accessed" form="text"/></group></group></else-if></choose></if></choose></macro><macro name="title"><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></if><else><text variable="title" form="long" quotes="true" strip-periods="false" text-case="title"/></else></choose></macro><macro name="legal_case"><group prefix=" " delimiter=" "><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="container-title" form="long" quotes="false" strip-periods="false"/></group><text variable="authority" form="long" prefix=" (" suffix=")" quotes="false" strip-periods="false"/></macro><macro name="publisher"><choose><if type="thesis" match="none"><group delimiter=": "><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group><text variable="genre" form="long" prefix=". " quotes="false" strip-periods="false"/></if><else><group delimiter=". "><text variable="genre" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group></else></choose></macro><macro name="year-date"><choose><if variable="issued" match="all"><date variable="issued"><date-part name="year" strip-periods="false"/></date></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><macro name="locator"><choose><if locator="page" match="all"><text variable="locator" form="long" quotes="false" strip-periods="false"/></if><else><group delimiter=" "><label variable="locator" form="short" plural="contextual" strip-periods="false"/><text variable="locator" form="long" quotes="false" strip-periods="false"/></group></else></choose></macro><locale xml:lang="en-US"><date form="text"><date-part name="month" suffix=" " strip-periods="false"/><date-part name="day" suffix=", " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></locale><locale xml:lang="nb-NO"><date form="text"><date-part name="day" suffix=" " strip-periods="false"/><date-part name="month" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></locale><locale xml:lang="nn-NO"><date form="text"><date-part name="day" suffix=" " strip-periods="false"/><date-part name="month" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></locale></style>