eriods="false"/></group></else-if><else-if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></group></else-if><else-if type="webpage" match="all"><group><text variable="URL" form="long" suffix=". " quotes="false" strip-periods="false"/><text term="accessed" form="long" plural="false" suffix=": " quotes="false" strip-periods="false" text-case="capitalize-first"/><date variable="accessed"><date-part name="day" form="numeric-leading-zeros" suffix=". " strip-periods="false"/><date-part name="month" suffix=" " strip-periods="true"/><date-part name="year" strip-periods="false"/></date></group></else-if><else-if type="thesis" match="all"><group delimiter=", "><text variable="genre" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group></else-if><else><group delimiter=": "><group delimiter=" "><text variable="container-title" form="short" quotes="false" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/></group><text variable="page" form="long" quotes="false" strip-periods="false"/></group></else></choose></layout></bibliography><macro name="author"><names variable="author"><name delimiter-precedes-et-al="never" delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="true"/></group></if><else><text variable="edition" form="long" quotes="false" strip-periods="false"/></else></choose></macro><m