<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="sort-only"><info><author><name>Sebastian Karcher</name></author><contributor><name>Mark Dingemanse</name><email>mark.dingemanse@mpi.nl</email></contributor><category citation-format="author-date"/><category field="anthropology"/><id>http://www.zotero.org/styles/american-anthropological-association</id><link href="http://www.zotero.org/styles/american-anthropological-association" rel="self"/><link href="http://www.aaanet.org/publications/style_guide.pdf" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>Citation style for the American Anthropological Association - Support from the Society for Cultural Anthropology is thankfully acknowledged</summary><title>American Anthropological Association</title><title-short>AAA</title-short><updated>2012-09-27T22:06:38+00:00</updated></info><citation disambiguate-add-givenname="true" givenname-disambiguation-rule="by-cite" disambiguate-add-names="true" disambiguate-add-year-suffix="true" near-note-distance="5" et-al-min="4" et-al-use-first="1"><layout prefix="(" suffix=")" delimiter="; "><group delimiter=":"><group delimiter=" "><text macro="contributors-short" quotes="false" strip-periods="false"/><text macro="date-reference" quotes="false" strip-periods="false"/></group><text macro="point-locators" quotes="false" strip-periods="false"/></group></layout></citation><bibliography hanging-indent="false" line-spacing="1" entry-spacing="0" subsequent-author-substitute="" subsequent-author-substitute-rule="complete-all" et-al-min="6" et-al-use-first="3"><sort><key macro="contributors" sort="ascending"/><key variable="issued" sort="ascending"/></sort><layout suffix="."><group display="block"><text macro="contributors" quotes="false" strip-periods="false"/></group><group display="left-margin"><text macro="date-bibliography" prefix=" " quotes="false" strip-periods="false"/><date variable="original-date" prefix="[" suffix="]"><date-part name="year" strip-periods="false"/></date></group><group display="right-inline"><group delimiter=". "><text macro="title" quotes="false" strip-periods="false"/><text macro="description" quotes="false" strip-periods="false"/><text macro="secondary-contributors" quotes="false" strip-periods="false"/><text macro="container-title" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><text macro="container-contributors" quotes="false" strip-periods="false"/></group><text macro="locators-chapter" quotes="false" strip-periods="false"/><text macro="locators" quotes="false" strip-periods="false"/><text macro="collection-title" prefix=". " quotes="false" strip-periods="false"/><text macro="issue" quotes="false" strip-periods="false"/><text macro="locators-article" quotes="false" strip-periods="false"/><text macro="access" prefix=". " quotes="false" strip-periods="false"/></group></layout></bibliography><macro name="secondary-contributors"><choose><if type="chapter paper-conference" match="none"><group delimiter=". "><names variable="editor" delimiter=", "><name delimiter=", " and="text"/><label form="short" plural="contextual" prefix=", " strip-periods="false"/></names><names variable="translator" delimiter=", "><name delimiter=", " and="text"/><label form="short" plural="contextual" prefix=", " strip-periods="false"/></names></group></if></choose></macro><macro name="container-contributors"><choose><if type="chapter paper-conference" match="any"><group prefix=" " delimiter=". "><names variable="editor" delimiter=", "><name delimiter=", " and="text"/><label form="short" plural="contextual" prefix=", " strip-periods="false"/></names><names variable="translator" delimiter=", "><name delimiter=", " and="text"/><label form="short" plural="contextual" prefix=", " strip-periods="false"/></names></group></if></choose></macro><macro name="recipient"><choose><if type="personal_communication" match="all"><choose><if variable="genre" match="all"><text variable="genre" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/></if><else><text term="letter" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/></else></choose></if></choose><names variable="recipient" delimiter=", "><label form="verb" plural="contextual" prefix=" " suffix=" " strip-periods="false"/><name delimiter=", " and="text"/></names></macro><macro name="contributors"><choose><if type="motion_picture" match="none"><names variable="author"><name delimiter=", " and="text" delimiter-precedes-last="always" name-as-sort-order="first" sort-separator=", "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/><substitute><names variable="editor"/><names variable="translator"/><text macro="title" quotes="false" strip-periods="false"/></substitute></names><text macro="recipient" quotes="false" strip-periods="false"/></if><else><names variable="author"><name delimiter=", " and="text" delimiter-precedes-last="always" name-as-sort-order="first" sort-separator=", " suffix=", dir."/><label form="short" plural="contextual" prefix=", " strip-periods="false"/><substitute><text macro="title" quotes="false" strip-periods="false"/></substitute></names></else></choose></macro><macro name="contributors-short"><names variable="author"><name delimiter=", " form="short" and="text"/><substitute><names variable="editor"/><names variable="translator"/><text macro="title" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="interviewer"><names variable="interviewer" delimiter=", "><label form="verb" plural="contextual" prefix=" " suffix=" " text-case="capitalize-first" strip-periods="false"/><name delimiter=", " and="text"/></names></macro><macro name="archive"><choose><if variable="archive archive_location" match="any"><group delimiter=". "><text variable="archive_location" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="archive" form="long" quotes="false" strip-periods="false"/><text variable="archive-place" form="long" quotes="false" strip-periods="false"/></group></if></choose></macro><macro name="access"><choose><if variable="URL" match="all"><group delimiter=", "><text variable="URL" form="long" quotes="false" strip-periods="false"/><group delimiter=" "><text term="accessed" form="long" plural="false" quotes="false" strip-periods="false"/><date variable="accessed"><date-part name="month" form="long" strip-periods="false"/><date-part name="day" prefix=" " strip-periods="false"/><date-part name="year" prefix=", " strip-periods="false"/></date></group></group></if></choose></macro><macro name="title"><choose><if variable="title" match="none"><choose><if type="personal_communication" match="none"><text variable="genre" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/></if></choose></if><else><group delimiter=", "><text variable="title" form="long" quotes="false" strip-periods="false" text-case="title"/><group><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group><text term="volume" form="short" plural="false" quotes="false" strip-periods="false"/><number variable="volume" form="numeric"/></group></if></choose></group></group></else></choose></macro><macro name="edition"><choose><if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="long" plural="false" quotes="false" strip-periods="true"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></if></choose></macro><macro name="locators"><choose><if type="article-journal" match="all"><text variable="volume" form="long" prefix=" " quotes="false" strip-periods="false"/><text variable="issue" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></if></choose></macro><macro name="locators-chapter"><choose><if type="chapter paper-conference" match="any"><group delimiter=" "><label variable="page" form="short" plural="contextual" prefix=" " text-case="capitalize-first" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></if></choose></macro><macro name="locators-article"><choose><if type="article-newspaper article-journal article-magazine" match="any"><text variable="page" form="long" prefix=": " quotes="false" strip-periods="false"/></if></choose></macro><macro name="point-locators"><group><choose><if locator="page" match="none"><label variable="locator" form="short" plural="contextual" suffix=" " strip-periods="false"/></if></choose><text variable="locator" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="container-prefix"><text term="in" form="long" plural="false" font-style="italic" quotes="false" strip-periods="false" text-case="capitalize-first"/></macro><macro name="container-title"><choose><if type="chapter paper-conference" match="any"><text macro="container-prefix" suffix=" " quotes="false" strip-periods="false"/></if></choose><text variable="container-title" form="long" quotes="false" strip-periods="false" text-case="title"/></macro><macro name="publisher"><choose><if type="motion_picture" match="none"><group delimiter=": "><choose><if type="thesis" match="none"><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></if></choose><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group></if><else><group delimiter=". "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></group></else></choose></macro><macro name="date-reference"><choose><if variable="issued" match="all"><date variable="issued"><date-part name="year" strip-periods="false"/></date></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="date-bibliography"><choose><if variable="issued" match="all"><date variable="issued"><date-part name="year" strip-periods="false"/></date></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/></else></choose></macro><macro name="day-month"><date variable="issued"><date-part name="month" strip-periods="false"/><date-part name="day" prefix=" " strip-periods="false"/></date></macro><macro name="collection-title"><text variable="collection-title" form="long" quotes="false" strip-periods="false" text-case="title"/><text variable="collection-number" form="long" prefix=", " quotes="false" strip-periods="false"/></macro><macro name="event"><group delimiter=" "><text term="presented at" form="long" plural="false" prefix=" " quotes="false" strip-periods="false"/><text variable="event" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="description"><group delimiter=". "><text macro="interviewer" quotes="false" strip-periods="false"/><text variable="medium" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/></group><choose><if variable="title" match="none"/><else-if type="thesis manuscript" match="any"/><else><group delimiter=", "><text variable="genre" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/><choose><if type="report" match="all"><text variable="number" form="long" quotes="false" strip-periods="false"/></if></choose></group></else></choose></macro><macro name="issue"><choose><if type="speech" match="all"><group delimiter=", "><choose><if variable="genre" match="all"><text macro="event" prefix=" " quotes="false" strip-periods="false"/></if><else><text macro="event" prefix=". Paper " quotes="false" strip-periods="false"/></else></choose><text variable="event-place" form="long" quotes="false" strip-periods="false"/><text macro="day-month" quotes="false" strip-periods="false"/></group></if><else-if type="article-newspaper article-magazine" match="any"><text macro="day-month" prefix=", " quotes="false" strip-periods="false"/></else-if><else-if type="interview broadcast" match="any"><group prefix=". " delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text macro="day-month" quotes="false" strip-periods="false"/></group></else-if><else><group prefix=". " delimiter=", "><choose><if type="thesis manuscript" match="any"><text variable="genre" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/></if></choose><text macro="archive" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></else></choose></macro></style>