uotes="false" strip-periods="false"/><text variable="number" form="long" quotes="false" strip-periods="false"/><text variable="section" form="long" quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/></group></else-if><else><group delimiter=", "><text variable="container-title" form="long" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="issue" form="long" quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/><text macro="page" quotes="false" strip-periods="false"/></group></else></choose></group><text macro="access" prefix=". " quotes="false" strip-periods="false"/></layout></bibliography><macro name="issued"><choose><if type="article-journal bill book chapter graphic legal_case legislation motion_picture paper-conference song thesis" match="any"><date variable="issued"><date-part name="year" form="long" strip-periods="false"/></date></if><else-if type="report" match="any"><date variable="issued" form="text" date-parts="year-month"/></else-if><else><date variable="issued"><date-part name="month" form="short" strip-periods="true"/><date-part name="day" form="numeric-leading-zeros" prefix=" " suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></else></choose></macro><macro name="author"><names variable="author"><name delimiter=", " and="text" delimiter-precedes-last="always" initialize-with=". " name-as-sort-order="all"/><label form="short" plural="contextual" prefix=", " text-case="capitalize-first" strip-periods="false"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="editor"><names variable="editor"><label form="verb" plural="contextual" suffix=" " strip-periods="false"/><name delimiter=", " and="text" initialize-with=". "/></names></macro><macro name="title"><text variable="title" form="long" quotes="true" strip-periods="false" text-case="title"/></macro><macro name="publisher"><group delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="page"><group delimiter=" "><label variable="page" form="short" plural="contextual" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="access"><choose><if variable="DOI" match="any"><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></if><else-if type="webpage post post-weblog article-journal" match="any"><group delimiter=". "><group delimiter=" "><text term="retrieved" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><date variable="accessed"><date-part name="day" suffix=" " strip-periods="false"/><date-part name="month" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group><text variable="URL" form="long" quotes="false" strip-periods="false"/></group></else-if></choose></macro><macro name="volume"><group delimiter=" "><label variable="volume" form="short" plural="contextual" text-case="capitalize-first" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/></group></macro></style>