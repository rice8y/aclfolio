strip-periods="false"/><text macro="title" suffix=". " quotes="false" strip-periods="false"/><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group suffix="." delimiter=" "><text macro="edition" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></if><else-if type="chapter paper-conference" match="any"><group delimiter=". "><group><text term="in" form="long" plural="false" suffix=": " quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="editor" prefix=", " quotes="false" strip-periods="false"/></group><text variable="event" form="long" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group><text variable="page" form="long" prefix=", p. " suffix="." quotes="false" strip-periods="false"/></else-if><else-if type="article-journal" match="all"><choose><if variable="issue volume" match="any"><text variable="container-title" form="short" font-style="italic" suffix=" " quotes="false" strip-periods="true"/><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="page" form="long" prefix=": " quotes="false" strip-periods="false"/><text macro="date" prefix=", " suffix="." quotes="false" strip-periods="false"/><text variable="DOI" form="long" prefix=" doi: " quotes="false" strip-periods="false"/></if></choose></else-if><else><group suffix="." delimiter=": "><group delimiter=" "><text variable="container-title" form="short" font-style="italic" quotes="false" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group><group delimiter=", "><text variable="page" form="long" quotes="false" strip-periods="false"/><text macro="date" quotes="false" strip-periods="false"/></group></group></else></choose><text macro="access" quotes="false" strip-periods="false"/></layout></bibliography><macro name="author"><names variable="author" suffix=". "><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" " font-weight="bold"/><label form="long" plural="contextual" prefix=", " suffix="." strip-periods="false"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="editor"><names variable="editor" prefix="edited by "><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/></names></macro><macro name="publisher"><choose><if variable="URL" match="all"><text variable="publisher" form="long" quotes="false" strip-periods="false"/></if><else><text variable="publisher-place" form="long" suffix=": " quotes="false" strip-periods="false"/><text variable="publisher" form="long" suffix=", " quotes="false" strip-periods="false"/><text macro="date" quotes="false" strip-periods="false"/></else></choose></macro><macro name="date"><choose><if variable="issued" match="all"><choose><if type="article-journal" match="all"><date variable="issued"><date-part name="year" strip-periods="false"/></date></if><else><date variable="issued"><date-part name="year" strip-periods="false"/></date></else></choose></if><else><text term="no date" form="long" plural="false" prefix="[" suffix="]" quotes="false" strip-periods="false"/></else></choose></macro><macro name="access"><choose><if variable="DOI" match="all"/><else><choose><if variable="URL" match="all"><group prefix=" " delimiter=" "><group><text variable="URL" form="long" quotes="false" strip-periods="false"/></group><group prefix="[" suffix="]" delimiter=" "><date variable="accessed"><date-part name="day" strip-periods="false"/><date-part name="month" form="short" prefix=" " suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group></group></if></choose></else></choose></macro><macro name="title"><choose><if variable="DOI" match="all"><text variable="title" form="long" quotes="false" strip-periods="false"/></if><else><group delimiter=" "><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><choose><if variable="URL" match="all"><text variable="title" form="long" quotes="false" strip-periods="false"/></if><else><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false"/></else></choose></if><else><text variable="title" form="long" quotes="false" strip-periods="false"/></else></choose><choose><if variable="URL" match="all"><text term="online" form="long" plural="false" prefix="[" suffix="]" quotes="false" strip-periods="false" text-case="capitalize-first"/></if></choose></group></else></choose></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><locale xml:lang="en"><terms><term name="no date" form="long">date unknown</term></terms></locale></style>