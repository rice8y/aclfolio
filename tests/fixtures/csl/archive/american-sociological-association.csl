<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" initialize-with-hyphen="true" page-range-format="chicago-15" demote-non-dropping-particle="sort-only"><info><author><name>Julian Onions</name><email>julian.onions@gmail.com</email></author><contributor><name>Patrick O'Brien</name></contributor><category citation-format="author-date"/><category field="sociology"/><id>http://www.zotero.org/styles/american-sociological-association</id><link href="http://www.zotero.org/styles/american-sociological-association" rel="self"/><link href="http://owl.english.purdue.edu/owl/resource/583/03/" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>The ASA style following the 6th/7th edition of the Style Guide (reference formatting is the same for both editions).</summary><title>American Sociological Association 6th/7th edition</title><title-short>ASA</title-short><updated>2023-07-16T21:48:56+00:00</updated></info><citation disambiguate-add-givenname="true" givenname-disambiguation-rule="by-cite" disambiguate-add-names="true" disambiguate-add-year-suffix="true" collapse="year" near-note-distance="5" et-al-min="4" et-al-use-first="1" et-al-subsequent-min="3" et-al-subsequent-use-first="1"><sort><key macro="author-short" sort="ascending"/><key macro="year-sort" sort="ascending"/></sort><layout prefix="(" suffix=")" delimiter="; "><group delimiter=":"><group delimiter=" "><text macro="author-short" quotes="false" strip-periods="false"/><text macro="year-date" quotes="false" strip-periods="false"/></group><text variable="locator" form="long" quotes="false" strip-periods="false"/></group></layout></citation><bibliography hanging-indent="true" line-spacing="1" entry-spacing="1" subsequent-author-substitute-rule="complete-all"><sort><key macro="author" sort="ascending"/><key macro="year-sort" sort="ascending"/><key variable="title" sort="ascending"/></sort><layout suffix="."><group delimiter=" "><text macro="author" suffix="." quotes="false" strip-periods="false"/><text macro="year-date" suffix="." quotes="false" strip-periods="false"/></group><choose><if type="article-newspaper article-magazine" match="any"><group delimiter=" "><text macro="title" prefix=" " suffix="." quotes="false" strip-periods="false"/></group><group prefix=" " delimiter=", "><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/><text macro="day-month" quotes="false" strip-periods="false"/><text variable="edition" form="long" quotes="false" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></if><else-if type="manuscript" match="all"><group delimiter=". "><text macro="title" prefix=" " quotes="true" strip-periods="false"/><group prefix=" " delimiter=", "><text macro="edition" quotes="false" strip-periods="false"/><text macro="editor" suffix="." quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group><text variable="genre" form="long" quotes="false" strip-periods="false"/></group></else-if><else-if type="thesis" match="all"><text macro="title" prefix=" " suffix="." quotes="true" strip-periods="false"/><group prefix=" " delimiter=", "><text macro="edition" quotes="false" strip-periods="false"/><text macro="editor" suffix="." quotes="false" strip-periods="false"/><text variable="genre" form="long" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></else-if><else-if type="book" variable="version" match="all"><group prefix=" " delimiter=". "><group><text macro="title" suffix=" [computer program]" quotes="false" strip-periods="false"/></group><group delimiter=" "><text term="version" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="version" form="long" quotes="false" strip-periods="false"/></group><text variable="URL" form="long" quotes="false" strip-periods="false"/></group></else-if><else-if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group delimiter=". "><text macro="title" prefix=" " quotes="false" strip-periods="false"/><text macro="volume" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><text macro="editor" suffix="." quotes="false" strip-periods="false"/><text macro="report" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></else-if><else-if type="chapter paper-conference" match="any"><group delimiter=" "><text macro="title" prefix=" " suffix="." quotes="false" strip-periods="false"/><group suffix="." delimiter=", "><group delimiter=" "><text macro="pages" quotes="false" strip-periods="false"/><text term="in" form="long" plural="false" quotes="false" strip-periods="false" text-case="lowercase"/><group delimiter=". "><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="volume" quotes="false" strip-periods="false"/></group></group><text variable="collection-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="editor" quotes="false" strip-periods="false"/></group><text macro="publisher" quotes="false" strip-periods="false"/></group></else-if><else-if type="speech" match="any"><group delimiter=", "><group delimiter=". "><text macro="title" quotes="false" strip-periods="false"/><group delimiter=" "><text term="presented at" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="event" form="long" quotes="false" strip-periods="false"/></group></group><text macro="day-month" quotes="false" strip-periods="false"/><text variable="event-place" form="long" quotes="false" strip-periods="false"/></group></else-if><else><group suffix="."><text macro="title" prefix=" " quotes="false" strip-periods="false"/><text macro="editor" prefix=" " quotes="false" strip-periods="false"/></group><group prefix=" " suffix="." delimiter=" "><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/><group delimiter=":"><group><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="issue" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></else></choose><text macro="access" prefix=". " quotes="false" strip-periods="false"/></layout></bibliography><macro name="editor"><names variable="editor"><label form="verb" plural="contextual" suffix=" " strip-periods="false"/><name delimiter=", " and="text" initialize-with=". "/></names></macro><macro name="anon"><text term="anonymous" form="short" plural="false" quotes="false" strip-periods="true" text-case="capitalize-first"/></macro><macro name="author"><names variable="author"><name delimiter=", " and="text" delimiter-precedes-last="always" initialize="false" initialize-with=". " name-as-sort-order="first" sort-separator=", "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/><substitute><names variable="editor translator director"/><choose><if type="report" match="all"><text variable="publisher" form="long" quotes="false" strip-periods="false"/></if></choose><text macro="anon" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="author-short"><names variable="author"><name delimiter=", " form="short" and="text" initialize-with=". "/><substitute><names variable="editor director translator"/><choose><if type="report" match="all"><text variable="publisher" form="long" quotes="false" strip-periods="false"/></if></choose><text macro="anon" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="access"><group><choose><if type="webpage post-weblog post" match="any"><group delimiter=" "><text term="retrieved" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><date variable="accessed" form="text"/><text variable="URL" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group></if><else-if type="article-journal report" match="any"><text variable="DOI" form="long" prefix="doi: " quotes="false" strip-periods="false"/></else-if></choose></group></macro><macro name="title"><choose><if type="thesis" match="all"><text variable="title" form="long" quotes="false" strip-periods="false" text-case="title"/></if><else-if type="book" variable="version" match="all"><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false"/></else-if><else-if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></else-if><else><text variable="title" form="long" quotes="true" strip-periods="false" text-case="title"/></else></choose></macro><macro name="publisher"><choose><if type="thesis manuscript" match="all"><group delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/><choose><if type="manuscript" match="any"><group delimiter=" "><text variable="genre" form="long" quotes="false" strip-periods="false"/><text variable="number" form="long" quotes="false" strip-periods="false"/></group></if></choose></group></if><else><group delimiter=": "><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group></else></choose></macro><macro name="year-date"><choose><if variable="issued" match="all"><group><group delimiter=" "><date variable="original-date" form="numeric" date-parts="year" prefix="[" suffix="]"/><date variable="issued" form="numeric" date-parts="year"/></group><text variable="year-suffix" form="long" quotes="false" strip-periods="false"/></group></if><else-if variable="status" match="all"><group><text variable="status" form="long" quotes="false" strip-periods="false" text-case="lowercase"/><text variable="year-suffix" form="long" prefix="-" quotes="false" strip-periods="false"/></group></else-if><else><group><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/><text variable="year-suffix" form="long" prefix="-" quotes="false" strip-periods="false"/></group></else></choose></macro><macro name="year-sort"><choose><if variable="issued" match="all"><date variable="issued" form="numeric" date-parts="year"/></if><else-if variable="status" match="all"><group><text variable="status" form="long" quotes="false" strip-periods="false" text-case="lowercase"/><text variable="year-suffix" form="long" prefix="-" quotes="false" strip-periods="false"/></group></else-if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="day-month"><date variable="issued"><date-part name="month" strip-periods="false"/><date-part name="day" prefix=" " strip-periods="false"/></date></macro><macro name="pages"><label variable="page" form="short" plural="contextual" suffix=" " text-case="capitalize-first" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><macro name="volume"><group delimiter=" "><label variable="volume" form="short" plural="contextual" text-case="capitalize-first" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="report"><choose><if type="report" match="any"><group delimiter=". "><text variable="genre" form="long" font-style="italic" quotes="false" strip-periods="false"/><text variable="number" form="long" quotes="false" strip-periods="false"/></group></if></choose></macro><locale xml:lang="en"><terms><term name="version" form="long">version</term></terms></locale></style>