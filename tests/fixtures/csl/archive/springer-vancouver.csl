<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" initialize-with-hyphen="true" page-range-format="minimal" demote-non-dropping-particle="sort-only"><info><author><name>Charles Parnot</name><email>charles.parnot@gmail.com</email><uri>http://twitter.com/cparnot</uri></author><category citation-format="numeric"/><category field="generic-base"/><id>http://www.zotero.org/styles/springer-vancouver-brackets</id><link href="http://www.zotero.org/styles/springer-vancouver-brackets" rel="self"/><link href="http://www.zotero.org/styles/vancouver" rel="template"/><link href="http://www.springer.com/cda/content/document/cda_downloaddocument/manuscript-guidelines-1.0.pdf" rel="documentation"/><link href="http://www.springer.com/cda/content/document/cda_downloaddocument/Key_Style_Points_1.0.pdf" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>This style based on the NLM guidelines Citing Medicine is very similar to Vancouver and is used by a number of Springer publications.</summary><title>Springer - Vancouver (brackets)</title><updated>2023-05-14T09:16:49+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout prefix="[" suffix="]" delimiter=","><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" line-spacing="1" entry-spacing="1" subsequent-author-substitute-rule="complete-all" et-al-min="7" et-al-use-first="6"><layout><text variable="citation-number" form="long" suffix=". " quotes="false" strip-periods="false"/><group suffix=". " delimiter=". "><text macro="author" quotes="false" strip-periods="false"/><text macro="title" quotes="false" strip-periods="false"/></group><group suffix=". " delimiter=" "><text macro="editor" quotes="false" strip-periods="false"/><text macro="container-title" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/><group><text macro="date" quotes="false" strip-periods="false"/><text macro="journal-location" quotes="false" strip-periods="false"/><text macro="pages" quotes="false" strip-periods="false"/></group></group><text macro="report-details" suffix=". " quotes="false" strip-periods="false"/><text macro="access" quotes="false" strip-periods="false"/></layout></bibliography><macro name="author"><names variable="author"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " strip-periods="false"/><substitute><names variable="editor"/></substitute></names></macro><macro name="editor"><group delimiter=": "><choose><if type="chapter paper-conference" match="any"><text term="in" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/></if></choose><names variable="editor" suffix="."><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " strip-periods="false"/></names></group></macro><macro name="publisher"><choose><if type="article-journal article-newspaper article-magazine" match="none"><group suffix=";" delimiter=": "><choose><if type="thesis" match="all"><text variable="publisher-place" form="long" prefix="[" suffix="]" quotes="false" strip-periods="false"/></if><else><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></else></choose><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group></if></choose></macro><macro name="access"><choose><if variable="URL" match="all"><group delimiter=": "><group delimiter=" "><text term="retrieved" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text term="from" form="long" plural="false" quotes="false" strip-periods="false"/></group><text variable="URL" form="long" quotes="false" strip-periods="false"/></group></if></choose></macro><macro name="accessed-date"><choose><if variable="URL" match="all"><group prefix="[" suffix="]" delimiter=" "><text term="cited" form="long" plural="false" quotes="false" strip-periods="false" text-case="lowercase"/><date variable="accessed" form="text"/></group></if></choose></macro><macro name="container-title"><choose><if type="article-journal article-magazine chapter paper-conference article-newspaper" match="any"><group suffix="." delimiter=" "><text variable="container-title" form="short" quotes="false" strip-periods="true"/><choose><if variable="URL" match="all"><text term="internet" form="long" plural="false" prefix="[" suffix="]" quotes="false" strip-periods="false" text-case="capitalize-first"/></if></choose></group><text macro="edition" prefix=" " quotes="false" strip-periods="false"/></if><else-if type="bill legislation" match="any"><group delimiter=", "><group delimiter=". "><text variable="container-title" form="short" quotes="false" strip-periods="false"/><group delimiter=" "><text term="section" form="short" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="section" form="long" quotes="false" strip-periods="false"/></group></group><text variable="number" form="long" quotes="false" strip-periods="false"/></group></else-if><else><text variable="container-title" form="short" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><macro name="title"><text variable="title" form="long" quotes="false" strip-periods="false"/><choose><if type="article-journal article-magazine chapter paper-conference article-newspaper" match="none"><choose><if variable="URL" match="all"><text term="internet" form="long" plural="false" prefix=" [" suffix="]" quotes="false" strip-periods="false" text-case="capitalize-first"/></if></choose><text macro="edition" prefix=". " quotes="false" strip-periods="false"/></if></choose><choose><if type="thesis" match="all"><text variable="genre" form="long" prefix=" [" suffix="]" quotes="false" strip-periods="false"/></if></choose></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><macro name="date"><choose><if type="article-magazine article-newspaper" match="any"><group suffix=";" delimiter=" "><date variable="issued" form="text"/><text macro="accessed-date" quotes="false" strip-periods="false"/></group></if><else-if type="article-journal" match="any"><group suffix=";" delimiter=" "><date variable="issued" form="text" date-parts="year"/><text macro="accessed-date" quotes="false" strip-periods="false"/></group></else-if><else-if type="bill legislation" match="any"><group delimiter=", "><date variable="issued" delimiter=" "><date-part name="month" form="short" strip-periods="true"/><date-part name="day" strip-periods="false"/></date><date variable="issued"><date-part name="year" strip-periods="false"/></date></group></else-if><else-if type="report" match="all"><date variable="issued" delimiter=" "><date-part name="year" strip-periods="false"/><date-part name="month" form="short" strip-periods="true"/></date></else-if><else><group suffix="."><date variable="issued"><date-part name="year" strip-periods="false"/></date><text macro="accessed-date" prefix=" " quotes="false" strip-periods="false"/></group></else></choose></macro><macro name="pages"><choose><if type="article-journal article-magazine article-newspaper" match="any"><text variable="page" form="long" prefix=":" quotes="false" strip-periods="false"/></if><else><group prefix=" " delimiter=" "><label variable="page" form="short" plural="never" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></else></choose></macro><macro name="journal-location"><choose><if type="article-journal article-magazine" match="any"><text variable="volume" form="long" quotes="false" strip-periods="false"/></if></choose></macro><macro name="report-details"><choose><if type="report" match="all"><text variable="number" form="long" prefix="Report No.: " quotes="false" strip-periods="false"/></if></choose></macro><locale xml:lang="en"><terms><term name="retrieved" form="long">available</term><term name="section" form="short">sect.</term></terms><date form="text" delimiter=" "><date-part name="year" strip-periods="false"/><date-part name="month" form="short" strip-periods="true"/><date-part name="day" strip-periods="false"/></date></locale><locale xml:lang="fr"><terms><term name="retrieved" form="long">disponible</term><term name="from" form="long">sur</term></terms><date form="text" delimiter=" "><date-part name="day" strip-periods="false"/><date-part name="month" form="short" strip-periods="true"/><date-part name="year" strip-periods="false"/></date></locale><locale xml:lang="de"><terms><term name="retrieved" form="long">verfügbar</term><term name="from" form="long">unter</term></terms></locale></style>