<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-GB" version="1.0" class="in-text" initialize-with-hyphen="true" page-range-format="minimal" demote-non-dropping-particle="sort-only"><info><author><name>Sebastian Karcher</name></author><contributor><name>Sean Takats</name><email>stakats@gmu.edu</email></contributor><contributor><name>Michael Berkowitz</name><email>mberkowi@gmu.edu</email></contributor><contributor><name>Patrick O'Brien</name></contributor><category citation-format="numeric"/><category field="medicine"/><id>http://www.zotero.org/styles/bmj</id><issn>0959-8138</issn><eissn>1756-1833</eissn><link href="http://www.zotero.org/styles/bmj" rel="self"/><link href="http://group.bmj.com/products/journals/instructions-for-authors/formatting#references" rel="documentation"/><link href="https://authors.bmj.com/writing-and-formatting/formatting-your-paper/" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>Vancouver style adapted for BMJ journals</summary><title>BMJ</title><updated>2024-06-06T09:34:02+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout prefix="[" suffix="]" delimiter=","><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" second-field-align="flush" line-spacing="1" entry-spacing="1" subsequent-author-substitute-rule="complete-all" et-al-min="4" et-al-use-first="3"><layout><text variable="citation-number" form="long" suffix=" " quotes="false" strip-periods="false"/><group suffix="." delimiter=". "><text macro="author" quotes="false" strip-periods="false"/><text macro="title" quotes="false" strip-periods="false"/><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group delimiter=". "><text macro="edition" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></if><else-if type="chapter paper-conference" match="any"><group delimiter=". "><group delimiter=": "><text term="in" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text macro="editor" quotes="false" strip-periods="false"/></group><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><group delimiter=":"><text macro="publisher" quotes="false" strip-periods="false"/><text variable="page" form="long" suffix="." quotes="false" strip-periods="false"/></group></group></else-if><else><text macro="journal-title" quotes="false" strip-periods="false"/><group><text macro="date" quotes="false" strip-periods="false"/><group prefix=";" delimiter=":"><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></else></choose></group><text macro="access" prefix=" " quotes="false" strip-periods="false"/></layout></bibliography><macro name="author"><names variable="author"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " strip-periods="false"/><et-al term="et al" font-style="italic"/><substitute><names variable="editor"/></substitute></names></macro><macro name="editor"><names variable="editor"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/><et-al term="et al" font-style="italic"/></names></macro><macro name="publisher"><group delimiter=" "><group suffix=" " delimiter=": "><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group><text macro="date" quotes="false" strip-periods="false"/></group></macro><macro name="access"><choose><if type="article-journal" match="all"><text variable="DOI" form="long" prefix="doi: " quotes="false" strip-periods="false"/></if><else-if type="webpage post post-weblog" match="any"><group delimiter=" "><text variable="URL" form="long" quotes="false" strip-periods="false"/><group prefix="(" suffix=")" delimiter=" "><text term="accessed" form="long" plural="false" quotes="false" strip-periods="false"/><date variable="accessed"><date-part name="day" suffix=" " strip-periods="false"/><date-part name="month" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group></group></else-if></choose></macro><macro name="journal-title"><choose><if type="article-journal article-magazine" match="any"><text variable="container-title" form="short" font-style="italic" quotes="false" strip-periods="true"/></if><else><text variable="container-title" form="short" quotes="false" strip-periods="false"/></else></choose></macro><macro name="date"><choose><if type="article-journal" match="all"><choose><if variable="volume page" match="none"><choose><if variable="DOI URL" match="any"><group prefix="Published Online First: "><date variable="issued" delimiter=" "><date-part name="day" strip-periods="false"/><date-part name="month" form="long" strip-periods="false" text-case="capitalize-first"/><date-part name="year" strip-periods="false"/></date></group></if><else><date variable="issued"><date-part name="year" strip-periods="false"/></date></else></choose></if><else><date variable="issued"><date-part name="year" strip-periods="false"/></date></else></choose></if><else><date variable="issued"><date-part name="year" strip-periods="false"/></date></else></choose></macro><macro name="title"><choose><if type="book thesis" match="any"><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false"/></if><else><text variable="title" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" quotes="false" strip-periods="false"/></else></choose></macro></style>