<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="never"><info><author><name>Jens Allmer</name><email>jens@allmer.de</email><uri>http://jens.allmer.de</uri></author><contributor><name>Sebastian Karcher</name></contributor><category citation-format="author-date"/><category field="generic-base"/><id>http://www.zotero.org/styles/springer-basic-author-date</id><link href="http://www.zotero.org/styles/springer-basic-author-date" rel="self"/><link href="http://www.springer.com/cda/content/document/cda_downloaddocument/instruct-authors-e.pdf" rel="documentation"/><link href="http://www.springer.com/cda/content/document/cda_downloaddocument/manuscript-guidelines-1.0.pdf" rel="documentation"/><link href="http://www.springer.com/cda/content/document/cda_downloaddocument/Key_Style_Points_1.0.pdf" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>Springer Author Date Style for the disciplines Medicine, Biomedicine, Life Sciences, Chemistry, Geosciences, Computer Science, Engineering, Economics. This style is based on Harvard style and recommendations of the Council of Biology Editors.</summary><title>Springer - Basic (author-date)</title><updated>2019-09-25T12:00:00+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="true" cite-group-delimiter=", " collapse="year-suffix" near-note-distance="5" et-al-min="3" et-al-use-first="1"><sort><key variable="issued" sort="ascending"/><key macro="author" sort="ascending"/></sort><layout prefix="(" suffix=")" delimiter="; "><group delimiter=", "><group delimiter=" "><text macro="author-short" quotes="false" strip-periods="false"/><text macro="year" quotes="false" strip-periods="false"/></group><group delimiter=" "><label variable="locator" form="short" plural="contextual" strip-periods="false"/><text variable="locator" form="long" quotes="false" strip-periods="false"/></group></group></layout></citation><bibliography hanging-indent="true" line-spacing="1" entry-spacing="1" subsequent-author-substitute-rule="complete-all" et-al-min="5" et-al-use-first="3"><sort><key macro="author" sort="ascending"/><key variable="author" sort="ascending"/></sort><layout><group delimiter=" "><text macro="author" quotes="false" strip-periods="false"/><text macro="year-parenth" quotes="false" strip-periods="false"/><text macro="title" quotes="false" strip-periods="false"/></group><choose><if type="chapter paper-conference" match="any"><group prefix=". " delimiter=" "><text term="in" form="long" plural="false" suffix=":" quotes="false" strip-periods="false" text-case="capitalize-first"/><names variable="editor"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="short" plural="contextual" prefix=" (" suffix=")" strip-periods="true"/></names><group delimiter=", "><text variable="container-title" form="long" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/></group></group><group prefix=". " delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/><group delimiter=" "><label variable="page" form="short" plural="contextual" strip-periods="true"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></if><else-if type="article-journal" match="all"><choose><if variable="page volume" match="any"><group prefix=". " delimiter=". "><group delimiter=" "><text variable="container-title" form="short" quotes="false" strip-periods="true"/><group delimiter=":"><text variable="volume" form="long" suffix=":" quotes="false" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></group></if><else><group prefix=". " delimiter=". "><text variable="container-title" form="short" quotes="false" strip-periods="true"/><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></group></else></choose></else-if><else-if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group delimiter=". "><group prefix=". " delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></group><group><choose><if variable="version" match="any"><text variable="URL" form="long" prefix="URL " quotes="false" strip-periods="false"/></if></choose></group></group></else-if><else-if type="webpage post-weblog post" match="any"><group prefix=". " delimiter=". "><text variable="container-title" form="short" prefix="In: " quotes="false" strip-periods="false"/><text variable="URL" form="long" quotes="false" strip-periods="false"/><date variable="accessed"><date-part name="day" prefix="Accessed " suffix=" " strip-periods="false"/><date-part name="month" form="short" suffix=" " strip-periods="true"/><date-part name="year" strip-periods="false"/></date></group></else-if><else-if type="thesis" match="all"><group prefix=". " delimiter=", "><text variable="genre" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group></else-if><else><group prefix=". " delimiter=" "><text variable="container-title" form="short" quotes="false" strip-periods="false"/><group delimiter=":"><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></else></choose></layout></bibliography><macro name="author-short"><names variable="author"><name form="short" and="text"/><et-al term="et al"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="author"><names variable="author"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="short" plural="contextual" prefix=" (" suffix=")" strip-periods="true"/><et-al term="and others"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="year"><date variable="issued"><date-part name="year" strip-periods="false"/></date></macro><macro name="title"><choose><if type="book" match="all"><group delimiter=". "><group delimiter=", "><text variable="title" form="long" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/></group><choose><if type="book" variable="version" match="any"><text variable="version" form="long" prefix="Version " quotes="false" strip-periods="false"/></if></choose></group></if><else><text variable="title" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="year-parenth"><date variable="issued" prefix="(" suffix=")"><date-part name="year" strip-periods="false"/></date></macro><locale><terms><term name="and-others" form="long">et al</term><term name="et-al" form="long">et al.</term><term name="edition" form="short">edn.</term></terms></locale></style>