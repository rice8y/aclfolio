<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" initialize-with-hyphen="true" page-range-format="minimal-two" demote-non-dropping-particle="never"><info><author><name>Sebastian Karcher</name></author><contributor><name>Patrick O'Brien</name></contributor><category citation-format="author"/><category field="generic-base"/><id>http://www.zotero.org/styles/modern-language-association</id><link href="http://www.zotero.org/styles/modern-language-association" rel="self"/><link href="http://style.mla.org" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>This style adheres to the MLA 9th edition handbook. Follows the structure of references as outlined in the MLA Manual closely</summary><title>Modern Language Association 9th edition</title><title-short>MLA</title-short><updated>2023-07-21T20:05:10+00:00</updated></info><citation disambiguate-add-givenname="true" givenname-disambiguation-rule="by-cite" disambiguate-add-names="true" disambiguate-add-year-suffix="false" near-note-distance="5" et-al-min="3" et-al-use-first="1"><layout prefix="(" suffix=")" delimiter="; "><choose><if locator="page line" match="any"><group delimiter=" "><text macro="author-short" quotes="false" strip-periods="false"/><text variable="locator" form="long" quotes="false" strip-periods="false"/></group></if><else><group delimiter=", "><text macro="author-short" quotes="false" strip-periods="false"/><group><label variable="locator" form="short" plural="contextual" strip-periods="false"/><text variable="locator" form="long" quotes="false" strip-periods="false"/></group></group></else></choose></layout></citation><bibliography hanging-indent="true" line-spacing="2" entry-spacing="0" subsequent-author-substitute="---" subsequent-author-substitute-rule="complete-all" et-al-min="3" et-al-use-first="1"><sort><key macro="author" sort="ascending"/><key variable="title" sort="ascending"/></sort><layout suffix="."><group delimiter=". "><text macro="author" quotes="false" strip-periods="false"/><text macro="title" quotes="false" strip-periods="false"/><date variable="original-date" form="numeric" date-parts="year"/><group delimiter=", "><text macro="container-title" quotes="false" strip-periods="false"/><text macro="other-contributors" quotes="false" strip-periods="false"/><text macro="version" quotes="false" strip-periods="false"/><text macro="number" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/><text macro="publication-date" quotes="false" strip-periods="false"/><text macro="location" quotes="false" strip-periods="false"/></group><group delimiter=", "><text macro="container2-title" quotes="false" strip-periods="false"/><text macro="container2-location" quotes="false" strip-periods="false"/></group><text macro="accessed" quotes="false" strip-periods="false"/></group></layout></bibliography><macro name="author"><names variable="author"><name and="text" delimiter-precedes-et-al="always" delimiter-precedes-last="always" initialize="false" initialize-with=". " name-as-sort-order="first"/><label form="long" plural="contextual" prefix=", " strip-periods="false"/><substitute><names variable="editor"/><names variable="translator"/><text macro="title" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="author-short"><group delimiter=", "><names variable="author"><name form="short" and="text" initialize-with=". "/><substitute><names variable="editor"/><names variable="translator"/><text macro="title-short" quotes="false" strip-periods="false"/></substitute></names><choose><if disambiguate="true" match="all"><text macro="title-short" quotes="false" strip-periods="false"/></if></choose></group></macro><macro name="title"><choose><if variable="container-title" match="any"><text variable="title" form="long" quotes="true" strip-periods="false" text-case="title"/></if><else><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></else></choose></macro><macro name="title-short"><choose><if variable="container-title" match="any"><text variable="title" form="short" quotes="true" strip-periods="false" text-case="title"/></if><else><text variable="title" form="short" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></else></choose></macro><macro name="container-title"><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></macro><macro name="other-contributors"><choose><if variable="container-title" match="any"><group delimiter=", "><names variable="container-author" delimiter=", "><label form="verb" plural="contextual" suffix=" " strip-periods="false"/><name and="text"/></names><names variable="editor translator" delimiter=", "><label form="verb" plural="contextual" suffix=" " strip-periods="false"/><name and="text"/></names><names variable="director illustrator interviewer" delimiter=", "><label form="verb" plural="contextual" suffix=" " strip-periods="false"/><name and="text"/></names></group></if><else><group delimiter=", "><names variable="container-author" delimiter=", "><label form="verb" plural="contextual" suffix=" " text-case="capitalize-first" strip-periods="false"/><name and="text"/></names><names variable="editor translator" delimiter=", "><label form="verb" plural="contextual" suffix=" " text-case="capitalize-first" strip-periods="false"/><name and="text"/></names><names variable="director illustrator interviewer" delimiter=", "><label form="verb" plural="contextual" suffix=" " text-case="capitalize-first" strip-periods="false"/><name and="text"/></names></group></else></choose></macro><macro name="version"><group delimiter=", "><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/></else></choose><text variable="version" form="long" quotes="false" strip-periods="false"/><text variable="medium" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="volume-lowercase"><group delimiter=" "><text term="volume" form="short" plural="false" quotes="false" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="number"><group delimiter=", "><group><choose><if variable="edition container-title" match="any"><text macro="volume-lowercase" quotes="false" strip-periods="false"/></if><else-if variable="author" match="all"><choose><if variable="editor translator container-author illustrator interviewer director" match="any"><text macro="volume-lowercase" quotes="false" strip-periods="false"/></if></choose></else-if><else-if variable="editor" match="all"><choose><if variable="translator container-author illustrator interviewer director" match="any"><text macro="volume-lowercase" quotes="false" strip-periods="false"/></if></choose></else-if><else-if variable="container-author illustrator interviewer director" match="any"><text macro="volume-lowercase" quotes="false" strip-periods="false"/></else-if><else><group delimiter=" "><text term="volume" form="short" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="volume" form="long" quotes="false" strip-periods="false"/></group></else></choose></group><group delimiter=" "><text term="issue" form="short" plural="false" quotes="false" strip-periods="false"/><text variable="issue" form="long" quotes="false" strip-periods="false"/></group><choose><if type="report" match="all"><text variable="genre" form="long" quotes="false" strip-periods="false"/></if></choose><text variable="number" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="publisher"><choose><if type="thesis" match="any"><group delimiter=". "><date variable="issued" form="numeric" date-parts="year"/><group delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="genre" form="long" quotes="false" strip-periods="false"/></group></group></if><else-if type="article-magazine article-newspaper article-journal" match="none"><text variable="publisher" form="long" quotes="false" strip-periods="false"/></else-if></choose></macro><macro name="publication-date"><choose><if type="book chapter paper-conference motion_picture" match="any"><date variable="issued" form="numeric" date-parts="year"/></if><else-if type="article-journal" match="any"><date variable="issued" form="text" date-parts="year-month"/></else-if><else-if type="speech thesis" match="none"><date variable="issued" form="text"/></else-if></choose></macro><macro name="location"><group delimiter=", "><group delimiter=" "><label variable="page" form="short" plural="contextual" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group><choose><if variable="source" match="none"><text macro="URI" quotes="false" strip-periods="false"/></if></choose></group></macro><macro name="container2-title"><group delimiter=", "><choose><if type="speech" match="all"><text variable="event" form="long" quotes="false" strip-periods="false"/><date variable="event-date" form="text"/><text variable="event-place" form="long" quotes="false" strip-periods="false"/></if></choose><text variable="archive" form="long" quotes="false" strip-periods="false"/><text variable="archive-place" form="long" quotes="false" strip-periods="false"/><text variable="archive_location" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="container2-location"><choose><if variable="source" match="all"><choose><if variable="DOI URL" match="any"><group delimiter=", "><text variable="source" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="URI" quotes="false" strip-periods="false"/></group></if></choose></if></choose></macro><macro name="URI"><choose><if variable="DOI" match="all"><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></if><else><text variable="URL" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="accessed"><choose><if variable="issued" match="none"><group delimiter=" "><text term="accessed" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><date variable="accessed" form="text"/></group></if></choose></macro><locale xml:lang="en"><terms><term name="month-01" form="short">Jan.</term><term name="month-02" form="short">Feb.</term><term name="month-03" form="short">Mar.</term><term name="month-04" form="short">Apr.</term><term name="month-05" form="short">May</term><term name="month-06" form="short">June</term><term name="month-07" form="short">July</term><term name="month-08" form="short">Aug.</term><term name="month-09" form="short">Sept.</term><term name="month-10" form="short">Oct.</term><term name="month-11" form="short">Nov.</term><term name="month-12" form="short">Dec.</term><term name="translator" form="short">trans.</term></terms><date form="text"><date-part name="day" suffix=" " strip-periods="false"/><date-part name="month" form="short" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></locale></style>