<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="sort-only"><info><author><name>Richard Karnesky</name><email>karnesky+zotero@gmail.com</email><uri>http://arc.nucapt.northwestern.edu/Richard_Karnesky</uri></author><author><name>Brenton M. Wiernik</name></author><contributor><name>Anna C. Véron</name></contributor><category citation-format="numeric"/><category field="physics"/><id>http://www.zotero.org/styles/american-physics-society</id><link href="http://www.zotero.org/styles/american-physics-society" rel="self"/><link href="http://www.zotero.org/styles/american-institute-of-physics" rel="template"/><link href="https://journals.aps.org/prl/authors#techformat" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>Common style use by APS publications.</summary><title>American Physical Society</title><title-short>APS</title-short><updated>2022-03-02T11:58:54+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout prefix=" [" suffix="]" delimiter=","><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" second-field-align="flush" line-spacing="1" entry-spacing="0" subsequent-author-substitute-rule="complete-all"><layout suffix="."><text variable="citation-number" form="long" prefix="[" suffix="]" quotes="false" strip-periods="false"/><text macro="author" suffix=", " quotes="false" strip-periods="false"/><choose><if type="bill book figure graphic legal_case legislation map motion_picture song treaty" match="any"><group delimiter=" "><group delimiter=", "><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/><text macro="edition-volume" quotes="false" strip-periods="false"/></group><text macro="publisher" quotes="false" strip-periods="false"/></group></if><else-if type="broadcast chapter entry entry-dictionary entry-encyclopedia paper-conference" match="any"><group delimiter=", "><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/><group delimiter=" "><text term="in" form="long" plural="false" quotes="false" strip-periods="false"/><group delimiter=", "><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/><text macro="editor" quotes="false" strip-periods="false"/><text macro="edition-volume" quotes="false" strip-periods="false"/></group><group delimiter=", "><text macro="publisher" quotes="false" strip-periods="false"/><group delimiter=" "><label variable="page" form="short" plural="contextual" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></group></group></else-if><else-if type="patent" match="all"><group delimiter=", "><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/><group delimiter=" "><text variable="number" form="long" quotes="false" strip-periods="false"/><text macro="day-date" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group></group></else-if><else-if type="thesis report" match="any"><group delimiter=", "><text variable="title" form="long" quotes="false" strip-periods="false" text-case="title"/><group delimiter=" "><text variable="genre" form="long" quotes="false" strip-periods="false"/><group delimiter=" "><text term="issue" form="short" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="number" form="long" quotes="false" strip-periods="false"/></group></group><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text macro="year-date" quotes="false" strip-periods="false"/></group></else-if><else-if type="article" match="any"><group delimiter=", "><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/><choose><if variable="container-title" match="all"><text variable="container-title" form="long" quotes="false" strip-periods="false"/></if><else><text variable="number" form="long" quotes="false" strip-periods="false"/></else></choose></group></else-if><else-if type="dataset interview manuscript pamphlet personal_communication post post-weblog speech webpage" match="all"><group delimiter=", "><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/><choose><if variable="DOI" match="all"><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></if><else-if variable="URL" match="all"><text variable="URL" form="long" quotes="false" strip-periods="false"/></else-if><else><text value="(unpublished)" quotes="false" strip-periods="false"/></else></choose></group></else-if><else><group delimiter=", "><text variable="title" form="long" quotes="false" strip-periods="false"/><group delimiter=" "><text variable="container-title" form="short" quotes="false" strip-periods="false" text-case="title"/><group delimiter=", "><text variable="volume" form="long" font-weight="bold" quotes="false" strip-periods="false"/><group delimiter=" "><choose><if variable="number" match="all"><text variable="number" form="long" quotes="false" strip-periods="false"/></if><else><text variable="page-first" form="short" quotes="false" strip-periods="false"/></else></choose><text macro="year-date" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group></group></group></group></else></choose></layout></bibliography><macro name="author"><names variable="author"><name delimiter=", " and="text" et-al-min="11" et-al-use-first="1" initialize-with=". "/><label form="long" plural="contextual" prefix=", " suffix=" " strip-periods="false"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="editor"><names variable="editor"><label form="verb" plural="contextual" suffix=" " strip-periods="false"/><name delimiter=", " and="text" initialize-with=". "/></names></macro><macro name="year-date"><choose><if variable="issued" match="all"><date variable="issued"><date-part name="year" strip-periods="false"/></date></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="day-date"><choose><if variable="issued" match="all"><date variable="issued"><date-part name="day" suffix=" " strip-periods="false"/><date-part name="month" form="long" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="publisher"><group prefix="(" suffix=")" delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false" text-case="title"/><text macro="year-date" quotes="false" strip-periods="false"/></group></macro><macro name="edition-volume"><group delimiter=", "><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" quotes="false" strip-periods="false"/></else></choose><group delimiter=" "><label variable="volume" form="short" plural="contextual" text-case="capitalize-first" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/></group></group></macro></style>