<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-GB" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="sort-only"><info><author><name>Julian Onions</name><email>julian.onions@gmail.com</email></author><contributor><name>Ivan Bushmarinov</name><email>ib@ineos.ac.ru</email></contributor><contributor><name>Steven R. Kirk</name><email>steven.kirk@cantab.net</email></contributor><contributor><name>Patrick O'Brien</name></contributor><category citation-format="numeric"/><category field="chemistry"/><id>http://www.zotero.org/styles/royal-society-of-chemistry</id><link href="http://www.zotero.org/styles/royal-society-of-chemistry" rel="self"/><link href="http://www.rsc.org/learn-chemistry/resource/download/res00001664/cmp00004956/pdf" rel="documentation"/><link href="http://www.rsc.org/journals-books-databases/journal-authors-reviewers/prepare-your-article/#format-layout" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>The Royal Society of Chemistry journal style.</summary><title>Royal Society of Chemistry</title><updated>2024-11-02T19:25:57+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout vertical-align="sup" delimiter=","><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" second-field-align="flush" line-spacing="1" entry-spacing="0" subsequent-author-substitute-rule="complete-all"><layout suffix="."><text variable="citation-number" form="long" quotes="false" strip-periods="false"/><text macro="author" suffix=", " quotes="false" strip-periods="false"/><choose><if type="thesis" match="all"><group delimiter=", "><text variable="genre" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/></group></if><else-if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text macro="title" suffix=", " quotes="false" strip-periods="false"/><group delimiter=", "><text macro="publisher" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/><text variable="volume" form="long" prefix="vol. " quotes="false" strip-periods="false"/></group></else-if><else-if type="chapter paper-conference" match="any"><group delimiter=", "><text macro="book-container" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/><text variable="volume" form="long" prefix="vol. " quotes="false" strip-periods="false"/><text macro="pages" quotes="false" strip-periods="false"/></group></else-if><else-if type="article-journal" match="all"><group delimiter=", "><text variable="container-title" form="short" font-style="italic" quotes="false" strip-periods="false"/><choose><if variable="page" match="all"><text macro="issued" quotes="false" strip-periods="false"/><text variable="volume" form="long" font-weight="bold" quotes="false" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></if><else><text variable="DOI" form="long" prefix="DOI:" quotes="false" strip-periods="false"/></else></choose></group></else-if><else-if type="article" match="any"><group delimiter=", "><text variable="publisher" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/><text term="preprint" form="long" plural="false" quotes="false" strip-periods="false"/><choose><if variable="number" match="all"><group delimiter=":"><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="number" form="long" quotes="false" strip-periods="false"/></group></if></choose><choose><if variable="DOI" match="all"><text variable="DOI" form="long" prefix="DOI: " quotes="false" strip-periods="false"/></if><else><text variable="URL" form="long" quotes="false" strip-periods="false"/></else></choose></group></else-if><else-if type="webpage post-weblog" match="any"><group delimiter=", "><text variable="title" form="short" quotes="false" strip-periods="false"/><text variable="URL" form="long" quotes="false" strip-periods="false"/><group prefix="(" suffix=")" delimiter=" "><text term="accessed" form="long" plural="false" quotes="false" strip-periods="false"/><date variable="accessed" form="text"/></group></group></else-if><else-if type="software" match="any"><group delimiter=" "><text variable="title" form="short" quotes="false" strip-periods="false"/><group prefix="(" suffix=")" delimiter=" "><label variable="version" form="long" plural="contextual" strip-periods="false"/><text variable="version" form="long" quotes="false" strip-periods="false"/></group><choose><if variable="publisher" match="all"><text macro="publisher" quotes="false" strip-periods="false"/></if><else><choose><if variable="DOI" match="all"><text variable="DOI" form="long" prefix=", DOI:" quotes="false" strip-periods="false"/></if><else-if variable="URL" match="all"><text variable="URL" form="long" prefix=" " quotes="false" strip-periods="false"/></else-if></choose></else></choose><text macro="issued" quotes="false" strip-periods="false"/></group></else-if><else-if type="speech" match="any"><group delimiter=", "><group delimiter=" "><text term="presented at" form="long" plural="false" quotes="false" strip-periods="false"/><text variable="event" form="long" quotes="false" strip-periods="false"/></group><text variable="event-place" form="long" quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/></group></else-if><else><group delimiter=", "><text variable="container-title" form="short" font-style="italic" quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></else></choose></layout></bibliography><macro name="editor"><names variable="editor"><label form="short" plural="contextual" suffix=" " strip-periods="false"/><name delimiter=", " and="text" delimiter-precedes-last="never" initialize-with=". "/></names></macro><macro name="author"><choose><if type="patent" match="all"><group delimiter=", "><choose><if variable="authority" match="all"><text variable="authority" form="long" quotes="false" strip-periods="false"/></if><else><text variable="publisher" form="long" quotes="false" strip-periods="false"/></else></choose><text variable="number" form="long" quotes="false" strip-periods="false"/></group></if><else><names variable="author"><name delimiter=", " and="text" delimiter-precedes-last="never" initialize-with=". "/><label form="short" plural="contextual" prefix=", " text-case="capitalize-first" strip-periods="false"/><substitute><names variable="editor"/></substitute></names></else></choose></macro><macro name="title"><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false"/></if><else><text variable="title" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="publisher"><group delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="pages"><label variable="page" form="short" plural="contextual" suffix=" " strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></macro><macro name="book-container"><group delimiter=", "><group delimiter=" "><text term="in" form="long" plural="false" quotes="false" strip-periods="false"/><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/></group><text macro="editor" quotes="false" strip-periods="false"/></group></macro><macro name="issued"><choose><if type="speech" match="any"><date variable="issued"><date-part name="month" suffix=", " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></if><else><date variable="issued" form="text" date-parts="year"/></else></choose></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text value="edn" suffix="." quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><locale xml:lang="en"><terms><term name="presented at" form="long">presented in part at the</term></terms></locale></style>