p><text macro="edition" quotes="false" strip-periods="false"/><text variable="collection-title" form="long" suffix="." quotes="false" strip-periods="false"/><group suffix="."><text macro="publisher" quotes="false" strip-periods="false"/><group prefix="; " suffix="."><date variable="issued"><date-part name="year" strip-periods="false"/></date><text variable="page" form="long" prefix=":" quotes="false" strip-periods="false"/></group></group></group></else-if><else-if type="article-newspaper" match="all"><text variable="container-title" form="long" font-style="italic" prefix=" " suffix=". " quotes="false" strip-periods="false"/><choose><if variable="URL" match="all"><group suffix="." delimiter=". "><text variable="URL" form="long" quotes="false" strip-periods="false"/><group><date variable="issued"><date-part name="month" suffix=" " strip-periods="false"/><date-part name="day" suffix=", " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group><group><text term="accessed" form="long" plural="false" suffix=" " quotes="false" strip-periods="false" text-case="capitalize-first"/><date variable="accessed"><date-part name="month" suffix=" " strip-periods="false"/><date-part name="day" suffix=", " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group></group></if><else><group suffix="." delimiter=":"><group><date variable="issued"><date-part name="month" suffix=" " strip-periods="false"/><date-part name="day" suffix=", " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group><text variable="page" form="long" quotes="false" strip-periods="false"/></group></else></choose></else-if><else-if type="legal_case" match="all"><group prefix=" " suffix="," delimiter=" "><text macro="editor" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group><group prefix=" " delimiter=" "><text variable="container-title" form="long" quotes="false" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/></group><text variable="page" form="long" prefix=", " suffix=" " quotes="false" strip-periods="false"/><group prefix="(" suffix=")." delimiter=" "><text variable="authority" form="long" quotes="false" strip-periods="false"/><date variable="issued"><date-part name="year" strip-periods="false"/></date></group></else-if><else-if type="webpage post post-weblog" match="any"><text variable="container-title" form="long" prefix=" " suffix="." quotes="false" strip-periods="false"/></else-if><else-if type="speech" match="all"><group prefix=" " suffix=":"><choose><if variable="genre" match="all"><text variable="genre" form="long" suffix=" " quotes="false" strip-periods="false"/><text term="presented at" form="long" plural="false" quotes="false" strip-periods="false"/></if><else><text term="presented at" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/></else></choose></group><group prefix=" " suffix="." delimiter="; "><text variable="event" form="long" quotes="false" strip-periods="false"/><group><date variable="issued" delimiter=" "><date-part name="month" strip-periods="false"/><date-part name="day" suffix="," strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group><text variable="event-place" form="long" quotes="false" strip-periods="false"/></group></else-if><else-if type="thesis" match="any"><group prefix=" " suffix="." delimiter=". "><text variable="genre" form="long" quotes="false" strip-periods="false"/><group delimiter="; "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><date variable="issued" form="text" date-parts="year"/></group></group></else-if><else><text macro="editor" prefix=" " suffix="." quotes="false" strip-periods="false"/><group prefix=" " suffix="."><text variable="container-title" form="short" font-style="italic" suffix="." quotes="false" strip-periods="true"/><group prefix=" " delimiter=";"><choose><if variable="issue volume" match="any"><date variable="issued"><date-part name="year" strip-periods="false"/></date></if><else><group delimiter=" "><text value="Published online" quotes="false" strip-periods="false"/><date variable="issued" form="text" date-parts="year-month-day"/></group></else></choose><group><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="issue" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group></group><text variable="page" form="long" prefix=":" quotes="false" strip-periods="false"/></group></else></choose><text macro="access" prefix=" " quotes="false" strip-periods="false"/></layout></bibliography><macro name="editor"><names variable="editor"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/></names></macro><macro name="author"><group suffix="."><names variable="author"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/><substitute><names variable="editor"/><text macro="title" quotes="false" strip-periods="false"/></substitute></names></group></macro><macro name="access"><choose><if type="article-newspaper" match="none"><choose><if variable="DOI" match="all"><text value="doi:" quotes="false" strip-periods="false"/><text variable="DOI" form="long" quotes="false" strip-periods="false"/></if><else-if variable="URL" match="all"><group delimiter=". "><choose><if type="webpage post post-weblog" match="any"><date variable="issued" form="text"/></if></choose><group><text term="accessed" form="long" plural="false" suffix=" " quotes="false" strip-periods="false" text-case="capitalize-first"/><date variable="accessed"><date-part name="month" suffix=" " strip-periods="false"/><date-part name="day" suffix=", " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group><text variable="URL" form="long" quotes="false" strip-periods="false"/></group></else-if></choose></if></choose></macro><macro name="title"><choose><if type="bill book graphic legal_case legislation motion_picture report song thesis" match="any"><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></if><else><text variable="title" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="publisher"><text variable="publisher" form="long" quotes="false" strip-periods="false"/></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><locale xml:lang="en"><terms><term name="page-range-delimiter" form="long">-</term><term name="presented at" form="long">presented at</term></terms></locale></style>