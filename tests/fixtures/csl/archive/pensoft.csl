ix="." delimiter=". "><text macro="title" quotes="false" strip-periods="false"/><text macro="editor" quotes="false" strip-periods="false"/></group><group prefix=" " suffix="."><text variable="container-title" form="long" quotes="false" strip-periods="false"/><group prefix=" "><text variable="volume" form="long" quotes="false" strip-periods="false"/></group><text variable="page" form="long" prefix=": " suffix="." quotes="false" strip-periods="false"/></group></else></choose><text macro="access" prefix=" " quotes="false" strip-periods="false"/></layout></bibliography><macro name="editor"><names variable="editor" delimiter=", "><name initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="short" plural="contextual" prefix=" (" suffix=")" text-case="capitalize-first" strip-periods="false"/></names></macro><macro name="anon"><text term="anonymous" form="short" plural="false" quotes="false" strip-periods="true" text-case="capitalize-first"/></macro><macro name="author"><names variable="author"><name delimiter-precedes-last="never" initialize-with="" name-as-sort-order="all" sort-separator=" "/><et-al term="et al" font-style="italic"/><label form="short" plural="contextual" prefix=" (" suffix=")" text-case="capitalize-first" strip-periods="false"/><substitute><names variable="editor"/><text macro="anon" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="author-short"><names variable="author"><name delimiter=" " form="short" and="text" delimiter-precedes-last="never" initialize-with=". "/><substitute><names variable="editor"/><names variable="translator"/><text macro="anon" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="authorcount"><names variable="author"><name form="count"/></names></macro><macro name="access"><choose><if type="legal_case" match="none"><choose><if variable="DOI" match="all"><group delimiter=" "><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></group></if><else-if variable="URL" match="all"><group suffix="." delimiter=" "><text variable="URL" form="long" prefix="Available from: " quotes="false" strip-periods="false"/><group prefix="(" suffix=")"><date variable="accessed" form="text"/></group></group></else-if></choose></if></choose></macro><macro name="title"><text variable="title" form="long" quotes="false" strip-periods="false"/></macro><macro name="legal_case"><group prefix=" " delimiter=" "><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="container-title" form="long" quotes="false" strip-periods="false"/></group><text variable="authority" form="long" prefix=" (" suffix=")" quotes="false" strip-periods="false"/></macro><macro name="publisher"><choose><if type="thesis" match="none"><group delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></group><text variable="genre" form="long" prefix=". " quotes="false" strip-periods="false"/></if><else><group delimiter=". "><text variable="genre" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group></else></choose></macro><macro name="year-date"><choose><if variable="issued" match="all"><group><date variable="issued"><date-part name="year" strip-periods="false"/></date></group></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><macro name="locator"><choose><if locator="page" match="all"><text v