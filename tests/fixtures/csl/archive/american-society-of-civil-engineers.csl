<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="sort-only"><info><author><name>Rintze Zelle</name><uri>http://twitter.com/rintzezelle</uri></author><contributor><name>Patrick O'Brien</name></contributor><category citation-format="author-date"/><category field="engineering"/><id>http://www.zotero.org/styles/american-society-of-civil-engineers</id><link href="http://www.zotero.org/styles/american-society-of-civil-engineers" rel="self"/><link href="https://ascelibrary.org/doi/book/10.1061/9780784479018" rel="documentation"/><link href="https://ascelibrary.org/doi/pdf/10.1061/9780784479018" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>A style for American Society of Civil Engineers publications</summary><title>American Society of Civil Engineers</title><title-short>ASCE</title-short><updated>2022-02-04T18:00:42+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="true" collapse="year-suffix" near-note-distance="5" et-al-min="3" et-al-use-first="1"><sort><key macro="author" sort="ascending"/><key variable="issued" sort="ascending"/></sort><layout prefix="(" suffix=")" delimiter="; "><group delimiter=" "><text macro="author-short" quotes="false" strip-periods="false"/><text macro="issued-year" quotes="false" strip-periods="false"/><text macro="citation-locator" quotes="false" strip-periods="false"/></group></layout></citation><bibliography hanging-indent="true" line-spacing="1" entry-spacing="0" subsequent-author-substitute-rule="complete-all"><sort><key macro="author" sort="ascending"/><key variable="issued" sort="ascending"/></sort><layout suffix="."><group delimiter=". "><text macro="author" suffix="." quotes="false" strip-periods="false"/><text macro="issued" quotes="false" strip-periods="false"/><text macro="title" quotes="false" strip-periods="false"/><group delimiter=", "><text variable="container-title" form="short" font-style="italic" quotes="false" strip-periods="false"/><text variable="collection-title" form="long" quotes="false" strip-periods="false"/><text macro="container-contributors" quotes="false" strip-periods="false"/><text macro="secondary-contributors" quotes="false" strip-periods="false"/><text macro="locators" quotes="false" strip-periods="false"/></group><text macro="publisher" quotes="false" strip-periods="false"/></group><text macro="access" prefix=". " quotes="false" strip-periods="false"/></layout></bibliography><macro name="container-contributors"><choose><if type="chapter paper-conference" match="any"><names variable="editor translator" delimiter=", "><name delimiter=", " and="text" initialize-with=". "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/></names></if></choose></macro><macro name="secondary-contributors"><choose><if type="chapter paper-conference" match="none"><names variable="editor translator" delimiter=", " prefix=" (" suffix=")"><name delimiter=", " and="text" initialize-with=". "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/></names></if></choose></macro><macro name="author"><names variable="author"><name and="text" delimiter-precedes-last="always" initialize-with=". " name-as-sort-order="first"/><label form="short" plural="contextual" prefix=" (" suffix=")" text-case="capitalize-first" strip-periods="false"/><substitute><names variable="editor"/><names variable="translator"/><text macro="title" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="author-short"><names variable="author"><name delimiter=", " form="short" and="text" initialize-with=". "/><substitute><names variable="editor"/><names variable="translator"/><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="short" font-style="italic" quotes="false" strip-periods="false"/></if><else><text variable="title" form="short" quotes="true" strip-periods="false"/></else></choose></substitute></names></macro><macro name="title"><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false"/></if><else><text variable="title" form="long" quotes="true" strip-periods="false"/></else></choose></macro><macro name="publisher"><choose><if type="article-magazine article-newspaper" match="none"><group delimiter=". "><text variable="genre" form="long" quotes="false" strip-periods="false"/><group delimiter=": "><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group></group></if></choose></macro><macro name="issued"><choose><if variable="issued" match="all"><date variable="issued" form="text" date-parts="year"/></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="issued-year"><choose><if variable="issued" match="all"><date variable="issued"><date-part name="year" strip-periods="false"/></date></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="locators"><choose><if type="article-journal" match="any"><group delimiter=": "><group delimiter=" "><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="issue" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group><text variable="page" form="long" quotes="false" strip-periods="false"/></group></if><else-if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any"><text variable="page" form="long" quotes="false" strip-periods="false"/></else-if><else-if type="article-magazine article-newspaper" match="any"><date variable="issued" form="text" date-parts="year-month-day"/></else-if></choose></macro><macro name="citation-locator"><group><label variable="locator" form="short" plural="contextual" strip-periods="false"/><text variable="locator" form="long" prefix=" " quotes="false" strip-periods="false"/></group></macro><macro name="access"><choose><if type="webpage post post-weblog" match="any"><group delimiter=". "><group delimiter=" "><text term="accessed" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><date variable="accessed" form="text"/></group><text variable="URL" form="long" quotes="false" strip-periods="false"/></group></if><else-if type="article-journal" match="any"><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></else-if></choose></macro></style>