prefix=" (" suffix=")."><date-part name="year" strip-periods="false"/></date><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group prefix=" " delimiter=" "><text macro="title" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><text macro="editor" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></if><else-if type="chapter paper-conference" match="any"><group prefix=" " delimiter=" "><text macro="title" suffix="." quotes="false" strip-periods="false"/><text term="in" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="container-title" form="long" quotes="false" strip-periods="false"/><text variable="collection-title" form="long" suffix="." quotes="false" strip-periods="false"/></group><text macro="editor" prefix=", " quotes="false" strip-periods="false"/><group suffix="."><text macro="publisher" prefix=" " quotes="false" strip-periods="false"/><group prefix=", "><label variable="page" form="short" plural="contextual" suffix=" " strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></else-if><else-if type="article" match="all"><text macro="title" prefix=" " quotes="false" strip-periods="false"/><text term="article" form="long" plural="false" prefix=". " quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="publisher" form="long" prefix=" at " quotes="false" strip-periods="false"/><text macro="access" prefix=", " quotes="false" strip-periods="false"/></else-if><else-if type="dataset software" match="any"><group prefix=" " delimiter=". "><text macro="title" quotes="false" strip-periods="false"/><group delimiter=" "><group delimiter=" "><text term="version" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="version" form="long" quotes="false" strip-periods="false"/></group><text variable="publisher" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group><text macro="access" quotes="false" strip-periods="false"/></group></else-if><else><text macro="title" prefix=" " suffix="." quotes="false" strip-periods="false"/><group prefix=" " suffix="." delimiter=", "><group delimiter=" "><text variable="container-title" form="short" quotes="false" strip-periods="false"/><text variable="volume" form="long" font-style="italic" quotes="false" strip-periods="false"/></group><text variable="page" form="long" quotes="false" strip-periods="false"/></group></else></choose><text macro="access" prefix=" " quotes="false" strip-periods="false"/></layout></bibliography><macro name="editor"><names variable="editor" delimiter=", "><name delimiter=", " and="text" initialize-with=". "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/></names></macro><macro name="author"><names variable="author"><name delimiter=", " and="text" delimiter-precedes-last="always" initialize-with="." name-as-sort-order="all" sort-separator=", "/><label form="short" plural="contextual" prefix=" " strip-periods="false"/><substitute><names variable="editor"/><text variable="title" form="long" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="access"><choose><if variable="DOI" match="any"><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></if><else-if type="webpage dataset entry-dictionary entry-encyclopedia post post-weblog" match="any"><text variable="URL" form="long" quotes="false" strip-periods="false"/></else-if></choose></macro><macro name="title"><text variable="title" form="long" quotes="false" strip-periods="false"/></macro><macro name="publisher"><text variable="publisher" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro></style>