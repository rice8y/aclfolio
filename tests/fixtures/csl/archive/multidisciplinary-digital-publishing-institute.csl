name="issued"><date variable="issued" delimiter=" "><date-part name="year" strip-periods="false"/></date></macro><macro name="full-issued"><date variable="issued" delimiter=" "><date-part name="month" form="long" strip-periods="false"/><date-part name="day" strip-periods="false"/><date-part name="year" strip-periods="false"/></date></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><macro name="access"><choose><if type="book chapter" match="any"><text variable="ISBN" form="long" prefix=" ISBN " quotes="false" strip-periods="false"/></if><else-if type="article-journal" match="all"><text variable="DOI" form="long" prefix=", doi:" quotes="false" strip-periods="false"/></else-if></choose></macro><locale xml:lang="en"><terms><term name="available at" form="long">available online</term><term name="accessed" form="long">accessed on</term><term name="presented at" form="long">presented at the</term></terms></locale></style>