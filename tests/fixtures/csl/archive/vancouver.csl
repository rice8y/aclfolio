/></if></choose></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><macro name="date"><choose><if type="article-journal article-magazine article-newspaper review review-book" match="any"><group suffix=";" delimiter=" "><date variable="issued" form="text"/><text macro="accessed-date" quotes="false" strip-periods="false"/></group></if><else-if type="bill legislation" match="any"><group delimiter=", "><date variable="issued" delimiter=" "><date-part name="month" form="short" strip-periods="true"/><date-part name="day" strip-periods="false"/></date><date variable="issued"><date-part name="year" strip-periods="false"/></date></group></else-if><else-if type="report" match="all"><date variable="issued" delimiter=" "><date-part name="year" strip-periods="false"/><date-part name="month" form="short" strip-periods="true"/></date><text macro="accessed-date" prefix=" " quotes="false" strip-periods="false"/></else-if><else-if type="patent" match="all"><group suffix="."><group delimiter=", "><text variable="number" form="long" quotes="false" strip-periods="false"/><date variable="issued"><date-part name="year" strip-periods="false"/></date></group><text macro="accessed-date" prefix=" " quotes="false" strip-periods="false"/></group></else-if><else-if type="speech" match="all"><group delimiter="; "><group delimiter=" "><date variable="issued" delimiter=" "><date-part name="year" strip-periods="false"/><date-part name="month" form="short" strip-periods="true"/><date-part name="day" strip-periods="false"/></date><text macro="accessed-date" quotes="false" strip-periods="false"/></group><text variable="event-place" form="long" quotes="false" strip-periods="false"/></group></else-if><else><group suffix="."><date variable="issued"><date-part name="year" strip-periods="false"/></date><text macro="accessed-date" prefix=" " quotes="false" strip-periods="false"/></group></else></choose></macro><macro name="pages"><choose><if type="article-journal article-magazine article-newspaper review review-book" match="any"><text variable="page" form="long" prefix=":" quotes="false" strip-periods="false"/></if><else-if type="book" match="any"><text variable="number-of-pages" form="long" prefix=" " quotes="false" strip-periods="false"/><choose><if is-numeric="number-of-pages" match="all"><label variable="number-of-pages" form="short" plural="never" prefix=" " strip-periods="false"/></if></choose></else-if><else><group prefix=" " delimiter=" "><label variable="page" form="short" plural="never" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></else></choose></macro><macro name="journal-location"><choose><if type="article-journal article-magazine review review-book" match="any"><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="issue" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></if></choose></macro><macro name="webpage-part"><choose><if type="webpage" variable="container-title" match="all"><text variable="title" form="long" quotes="false" strip-periods="false"/></if></choose></macro><macro name="collection-details"><choose><if type="article-journal article-magazine article-newspaper review review-book" match="none"><choose><if variable="collection-title" match="all"><group prefix="(" suffix=")" delimiter=" "><names variable="collection-editor" suffix="."><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " strip-periods="false"/></names><group delimiter="; "><text variable="collection-title" form="long" quotes="false" strip-periods="false"/><group delimiter=" "><label variable="volume" form="short" plural="contextual" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/></group></group></group></if></choose></if></choose></macro><macro name="report-details"><choose><if type="report" match="all"><text variable="number" form="long" prefix="Report No.: " quotes="false" strip-periods="false"/></if></choose></macro><locale xml:lang="en"><terms><term name="collection-editor" form="long"><single>editor</single><multiple>editors</multiple></term><term name="presented at" form="long">presented at</term><term name="available at" form="long">available from</term><term name="section" form="short">sect.</term></terms><date form="text" delimiter=" "><date-part name="year" strip-periods="false"/><date-part name="month" form="short" strip-periods="true"/><date-part name="day" strip-periods="false"/></date></locale><locale xml:lang="fr"><date form="text" delimiter=" "><date-part name="day" strip-periods="false"/><date-part name="month" form="short" strip-periods="true"/><date-part name="year" strip-periods="false"/></date></locale></style>