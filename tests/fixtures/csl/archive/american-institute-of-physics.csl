<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="sort-only"><info><author><name>Richard Karnesky</name><email>karnesky+zotero@gmail.com</email><uri>http://arc.nucapt.northwestern.edu/Richard_Karnesky</uri></author><contributor><name>Patrick O'Brien</name></contributor><category citation-format="numeric"/><category field="physics"/><id>http://www.zotero.org/styles/american-institute-of-physics</id><link href="http://www.zotero.org/styles/american-institute-of-physics" rel="self"/><link href="http://www.aip.org/pubservs/style/4thed/toc.html" rel="documentation"/><link href="https://publishing.aip.org/wp-content/uploads/2021/03/AIP_Style_4thed.pdf" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>Common style used by AIP publications.</summary><title>American Institute of Physics 4th edition</title><title-short>AIP</title-short><updated>2024-03-27T11:18:50+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout vertical-align="sup" delimiter=","><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" line-spacing="1" entry-spacing="0" subsequent-author-substitute-rule="complete-all"><layout suffix="."><text variable="citation-number" form="long" vertical-align="sup" quotes="false" strip-periods="false"/><text macro="author" prefix=" " suffix=", " quotes="false" strip-periods="false"/><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group delimiter=" "><group delimiter=", "><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/><text macro="edition" quotes="false" strip-periods="false"/></group><group delimiter=", "><text macro="publisher" quotes="false" strip-periods="false"/><group delimiter=" "><label variable="page" form="short" plural="contextual" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></group></if><else-if type="chapter paper-conference" match="any"><group delimiter=", "><text variable="title" form="long" quotes="true" strip-periods="false"/><group delimiter=" "><text term="in" form="long" plural="false" quotes="false" strip-periods="false"/><text variable="container-title" form="short" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></group><text macro="editor" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/><group delimiter=" "><label variable="page" form="short" plural="contextual" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></else-if><else-if type="patent" match="all"><group delimiter=" "><text variable="number" form="long" prefix=" " quotes="false" strip-periods="false"/><text macro="day-date" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group></else-if><else-if type="thesis" match="all"><group delimiter=", "><text variable="title" form="long" quotes="false" strip-periods="false" text-case="title"/><text variable="genre" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text macro="year-date" quotes="false" strip-periods="false"/></group></else-if><else><group delimiter=", "><text variable="title" form="long" quotes="true" strip-periods="false"/><group delimiter=" "><text variable="container-title" form="short" quotes="false" strip-periods="false" text-case="title"/><group><text variable="volume" form="long" font-weight="bold" quotes="false" strip-periods="false"/><text variable="issue" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group></group><group delimiter=" "><text variable="page" form="long" quotes="false" strip-periods="false"/><text macro="year-date" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group></group></else></choose></layout></bibliography><macro name="author"><names variable="author"><name and="text" delimiter-precedes-last="always" initialize-with="."/><label form="long" plural="contextual" prefix=", " suffix=" " strip-periods="false"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="editor"><names variable="editor"><label form="verb" plural="contextual" suffix=" " strip-periods="false"/><name delimiter=", " and="text" initialize-with="."/></names></macro><macro name="year-date"><choose><if variable="issued" match="all"><date variable="issued"><date-part name="year" strip-periods="false"/></date></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="day-date"><choose><if variable="issued" match="all"><date variable="issued"><date-part name="day" suffix=" " strip-periods="false"/><date-part name="month" form="long" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="publisher"><group prefix="(" suffix=")" delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false" text-case="title"/><text macro="year-date" quotes="false" strip-periods="false"/></group></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" quotes="false" strip-periods="false"/></else></choose></macro></style>