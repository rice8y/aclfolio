<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" page-range-format="expanded" demote-non-dropping-particle="sort-only"><info><author><name>Carl J. Schreck, III</name><email>carl.schreck@gmail.com</email></author><contributor><name>Rintze Zelle</name><uri>http://twitter.com/rintzezelle</uri></contributor><category citation-format="author-date"/><category field="geography"/><id>http://www.zotero.org/styles/american-meteorological-society</id><link href="http://www.zotero.org/styles/american-meteorological-society" rel="self"/><link href="http://www.zotero.org/styles/cold-spring-harbor-laboratory-press" rel="template"/><link href="https://www.ametsoc.org/ams/index.cfm/publications/authors/journal-and-bams-authors/formatting-and-manuscript-components/references/" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>A style for all journals by the American Meteorological Society</summary><title>American Meteorological Society</title><title-short>AMS</title-short><updated>2019-06-25T09:03:36+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="true" collapse="year-suffix" year-suffix-delimiter="," near-note-distance="5" et-al-min="3" et-al-use-first="1"><layout prefix="(" suffix=")" delimiter="; "><group delimiter=", "><group delimiter=" "><text macro="author-short" quotes="false" strip-periods="false"/><text macro="year-date" quotes="false" strip-periods="false"/></group><group delimiter=" "><label variable="locator" form="short" plural="contextual" strip-periods="false"/><text variable="locator" form="long" quotes="false" strip-periods="false"/></group></group></layout></citation><bibliography hanging-indent="true" line-spacing="1" entry-spacing="1" subsequent-author-substitute="——" subsequent-author-substitute-rule="partial-each" et-al-min="9" et-al-use-first="1"><sort><key macro="author" names-min="1" names-use-first="1" sort="ascending"/><key macro="author-count" names-min="3" names-use-first="3" sort="ascending"/><key macro="year-date" sort="ascending"/><key macro="author" sort="ascending"/></sort><layout suffix="."><group delimiter=" "><text macro="author" suffix="," quotes="false" strip-periods="false"/><text macro="year-date" suffix=":" quotes="false" strip-periods="false"/></group><choose><if type="article-newspaper article-magazine" match="any"><group delimiter=" "><text macro="title" prefix=" " suffix="." quotes="false" strip-periods="false"/></group><group prefix=" " delimiter=", "><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="day-month" quotes="false" strip-periods="false"/><text variable="edition" form="long" quotes="false" strip-periods="false"/></group></if><else-if type="thesis" match="all"><text macro="title" prefix=" " suffix=". " quotes="false" strip-periods="false"/><text variable="publisher" form="long" suffix=", " quotes="false" strip-periods="false"/><text variable="number-of-pages" form="long" suffix=" pp." quotes="false" strip-periods="false"/></else-if><else-if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group delimiter=" "><text macro="title" prefix=" " suffix="." quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><text macro="editor" suffix="." quotes="false" strip-periods="false"/><text macro="publisher" suffix="," quotes="false" strip-periods="false"/><text variable="number-of-pages" form="long" suffix=" pp." quotes="false" strip-periods="false"/></group></else-if><else-if type="paper-conference" match="all"><group delimiter=" "><text macro="title" prefix=" " suffix="." quotes="false" strip-periods="false"/><group delimiter=", "><group delimiter=", "><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="editor" quotes="false" strip-periods="false"/></group><group delimiter=" "><text variable="volume" form="long" prefix="Vol. " suffix=" of" quotes="false" strip-periods="false"/><text variable="collection-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="series-editor" quotes="false" strip-periods="false"/></group><text variable="event" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></else-if><else-if type="chapter paper-conference" match="any"><group delimiter=" "><text macro="title" prefix=" " suffix="." quotes="false" strip-periods="false"/><group delimiter=", "><group delimiter=", "><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="editor" quotes="false" strip-periods="false"/></group><group delimiter=" "><text variable="volume" form="long" prefix="Vol. " suffix=" of" quotes="false" strip-periods="false"/><text variable="collection-title" form="long" font-style="italic" quotes="false" strip-periods="false"/><text macro="series-editor" quotes="false" strip-periods="false"/></group><text macro="publisher" prefix=" " quotes="false" strip-periods="false"/><text macro="page" quotes="false" strip-periods="false"/></group></group></else-if><else><group suffix="."><text macro="title" prefix=" " quotes="false" strip-periods="false"/></group><group prefix=" " suffix="." delimiter=" "><text variable="container-title" form="short" font-style="italic" suffix="," quotes="false" strip-periods="false"/><group delimiter=", "><text variable="volume" form="long" font-weight="bold" quotes="false" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></group></group></else></choose><text macro="access" prefix=" " suffix="." quotes="false" strip-periods="false"/></layout></bibliography><macro name="editor"><names variable="editor"><name delimiter=", " and="text" initialize-with="."><name-part name="family" text-case="capitalize-first"/><name-part name="given" text-case="capitalize-first"/></name><label form="short" plural="contextual" prefix=", " text-case="capitalize-first" strip-periods="false"/></names></macro><macro name="series-editor"><names variable="original-author"><label form="short" plural="contextual" suffix=" " text-case="capitalize-first" strip-periods="false"/><name delimiter=", " and="text"/></names></macro><macro name="author"><names variable="author"><name delimiter=", " and="text" delimiter-precedes-et-al="always" delimiter-precedes-last="always" initialize-with=". " name-as-sort-order="first" sort-separator=", "/><et-al term="and others"/><label form="short" plural="contextual" prefix=", " strip-periods="false"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="author-count"><names variable="author"><name form="count"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="author-short"><names variable="author"><name delimiter=", " form="short" and="text"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="access"><choose><if type="dataset thesis report paper-conference webpage post post-weblog" match="any"><choose><if variable="DOI" match="none"><text variable="URL" form="long" quotes="false" strip-periods="false"/><group prefix=" (" suffix=")"><text term="accessed" form="long" plural="false" suffix=" " quotes="false" strip-periods="false" text-case="capitalize-first"/><date variable="accessed"><date-part name="month" suffix=" " strip-periods="false"/><date-part name="day" suffix=", " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group></if></choose></if></choose></macro><macro name="title"><choose><if type="thesis" match="all"><text variable="title" form="long" quotes="false" strip-periods="false"/></if><else-if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false"/></else-if><else><text variable="title" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="publisher"><text variable="publisher" form="long" quotes="false" strip-periods="false"/></macro><macro name="year-date"><date variable="issued"><date-part name="year" strip-periods="false"/></date></macro><macro name="day-month"><date variable="issued"><date-part name="month" strip-periods="false"/><date-part name="day" prefix=" " strip-periods="false"/></date></macro><macro name="page"><label variable="page" form="short" plural="contextual" suffix=" " strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><locale xml:lang="en"><terms><term name="page" form="short"><single>p.</single><multiple/></term><term name="and-others" form="long">and Coauthors</term></terms></locale></style>