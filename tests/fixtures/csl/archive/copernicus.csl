" " delimiter=", "><text macro="title" quotes="false" strip-periods="false"/><text macro="container_conference" quotes="false" strip-periods="false"/><text variable="event" form="long" quotes="false" strip-periods="false"/><text variable="event-place" form="long" quotes="false" strip-periods="false"/><date variable="event-date"><date-part name="day" range-delimiter="-" suffix=" " strip-periods="false"/><date-part name="month" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date><text variable="note" form="long" quotes="false" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/><text macro="doi" quotes="false" strip-periods="false"/></group></else-if><else-if type="thesis" match="all"><group prefix=" " delimiter=", "><text macro="title" quotes="false" strip-periods="false"/><text variable="genre" form="long" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/><text variable="number-of-pages" form="long" suffix=" pp." quotes="false" strip-periods="false"/><text macro="doi" quotes="false" strip-periods="false"/></group></else-if><else-if type="map report" match="any"><group prefix=" " delimiter=", "><text macro="title" quotes="false" strip-periods="false"/><text variable="container-title" form="long" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/><text variable="number-of-pages" form="long" suffix=" pp." quotes="false" strip-periods="false"/><text macro="doi" quotes="false" strip-periods="false"/></group></else-if><else-if type="article-journal" match="any"><group prefix=" " delimiter=", "><text variable="title" form="long" quotes="false" strip-periods="false"/><text variable="container-title" form="short" quotes="false" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="page" form="long" quotes="false" strip-periods="false"/><text macro="doi" quotes="false" strip-periods="false"/></group></else-if><else><group prefix=" " suffix="," delimiter=", "><text macro="title" quotes="false" strip-periods="false"/><text macro="editor" quotes="false" strip-periods="false"/></group><group prefix=" "><text variable="container-title" form="short" quotes="false" strip-periods="false"/><group prefix=", " delimiter=", "><group><text variable="volume" form="long" quotes="false" strip-periods="false"/><text macro="published-date" quotes="false" strip-periods="false"/></group><text variable="archive" form="long" quotes="false" strip-periods="false"/><text macro="pages" quotes="false" strip-periods="false"/><text macro="doi" quotes="false" strip-periods="false"/></group></group></else></choose><text macro="year-date" prefix=", " suffix="." quotes="false" strip-periods="false"/></if><else><choose><if type="webpage" match="any"><text variable="title" form="long" suffix=": " quotes="false" strip-periods="false"/><text macro="access" prefix=" " suffix="." quotes="false" strip-periods="false"/></if><else-if type="article" match="any"><group suffix=":" delimiter=" "><text macro="author" quotes="false" strip-periods="false"/></group><group prefix=" " suffix="." delimiter=", "><text variable="title" form="long" quotes="false" strip-periods="false"/><text variable="archive" form="long" suffix=" [preprint]" quotes="false" strip-periods="false"/><choose><if variable="DOI" match="any"><text macro="doi" quotes="false" strip-periods="false"/></if><else><text variable="URL" form="long" quotes="false" strip-periods="false"/></else></choose><date variable="issued"><date-part name="day" suffix=" " strip-periods="false"/><date-part name="month" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group></else-if></choose></else></choose></layout></bibliography><macro name="editor"><names variable="editor" delimiter=", "><label form="verb" plural="contextual" suffix=": " strip-periods="false"/><name and="text" initialize-with=". " name-as-sort-order="all"/></names></macro><macro name="anon"><text term="anonymous" form="short" plural="false" quotes="false" strip-periods="true" text-case="capitalize-first"/></macro><macro name="author"><names variable="author"><name and="text" initialize-with=". " name-as-sort-order="all"/><label form="short" plural="contextual" prefix=" (" suffix=")" text-case="capitalize-first" strip-periods="false"/><substitute><names variable="editor collection-editor"/><text macro="anon" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="author-short"><names variable="author"><name delimiter=", " form="short" and="text" initialize-with=". "/><substitute><names variable="editor"/><names variable="translator"/><names variable="collection-editor"/><text macro="anon" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="author-count"><names variable="author"><name form="count"/><substitute><names variable="editor"/></substitute></names></macro><macro name="access"><choose><if variable="DOI" match="none"><choose><if variable="URL" match="all"><text variable="URL" form="long" quotes="false" strip-periods="false"/><group prefix=", " delimiter=": "><text term="accessed" form="long" plural="false" quotes="false" strip-periods="false"/><date variable="accessed"><date-part name="day" suffix=" " strip-periods="false"/><date-part name="month" suffix=" " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group></if></choose></if></choose></macro><macro name="title"><text variable="title" form="long" quotes="false" strip-periods="false"/></macro><macro name="publisher"><group delimiter=", "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="year-date"><choose><if variable="issued" match="all"><date variable="issued"><date-part name="year" strip-periods="false"/></date></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="published-date"><choose><if type="article-newspaper" match="all"><date variable="issued"><date-part name="day" form="ordinal" suffix=" " strip-periods="false"/><date-part name="month" form="long" strip-periods="false"/></date></if></choose></macro><macro name="pages"><text variable="page" form="long" quotes="false" strip-periods="false"/></macro><macro name="doi"><text variable="DOI" form="long" prefix="https://doi.org/" quotes="false" strip-periods="false"/></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><macro name="container"><group delimiter=", "><group delimiter=" "><text term="in" form="long" plural="false" suffix=":" quotes="false" strip-periods="false"/><text variable="container-title" form="long" quotes="false" strip-periods="false"/></group><group delimiter=" "><text term="volume" form="short" plural="false" quotes="false" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/></group><text macro="editor" quotes="false" strip-periods="false"/></group></macro><macro name="container_conference"><text term="in" form="long" plural="false" suffix=": " quotes="false" strip-periods="false"/><text variable="container-title" form="long" quotes="false" strip-periods="false"/></macro><locale xml:lang="en"><terms><term name="accessed" form="long">last access</term></terms></locale></style>