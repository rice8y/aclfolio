<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="sort-only"><info><author><name>David M. Kaplan</name><email>david.kaplan@ird.fr</email></author><category citation-format="numeric"/><category field="generic-base"/><id>http://www.zotero.org/styles/current-opinion</id><link href="http://www.zotero.org/styles/current-opinion" rel="self"/><link href="http://www.elsevier.com/journals/current-opinion-in-biotechnology/0958-1669/guide-for-authors" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><title>Current Opinion journals</title><updated>2012-09-27T22:06:38+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout prefix="[" suffix="]" delimiter=","><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" second-field-align="flush" line-spacing="1" entry-spacing="1" subsequent-author-substitute-rule="complete-all" et-al-min="11" et-al-use-first="10"><layout><text variable="citation-number" form="long" suffix=". " quotes="false" strip-periods="false"/><text macro="author" suffix=": " quotes="false" strip-periods="false"/><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text macro="title" font-style="italic" suffix=". " quotes="false" strip-periods="false"/><text macro="publisher" suffix="." quotes="false" strip-periods="false"/></if><else-if type="chapter paper-conference" match="any"><text macro="title" font-weight="bold" suffix=". " quotes="false" strip-periods="false"/><group suffix=". "><text term="in" form="long" plural="false" suffix=" " quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="container-title" form="long" font-style="italic" suffix=". " quotes="false" strip-periods="false"/><text macro="editor" quotes="false" strip-periods="false"/></group><group suffix="."><text macro="publisher" prefix=" " quotes="false" strip-periods="false"/><text variable="page" form="long" prefix=":" quotes="false" strip-periods="false"/></group></else-if><else><text macro="title" font-weight="bold" suffix=". " quotes="false" strip-periods="false"/><text variable="container-title" form="short" font-style="italic" suffix=" " quotes="false" strip-periods="true"/><text macro="date" suffix=", " quotes="false" strip-periods="false"/><text macro="volume-page" suffix="." quotes="false" strip-periods="false"/></else></choose></layout></bibliography><macro name="author"><names variable="author"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="short" plural="contextual" prefix=" (" suffix=")" text-case="capitalize-first" strip-periods="true"/><substitute><names variable="editor"/><names variable="translator"/></substitute></names></macro><macro name="editor"><names variable="editor"><label form="verb" plural="contextual" suffix=" " text-case="capitalize-first" strip-periods="false"/><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/></names></macro><macro name="publisher"><group delimiter="; "><text variable="publisher" form="long" quotes="false" strip-periods="false"/><text macro="date" quotes="false" strip-periods="false"/></group></macro><macro name="date"><choose><if variable="issued" match="all"><choose><if type="article-journal" match="all"><date variable="issued"><date-part name="year" strip-periods="false"/></date></if><else><date variable="issued"><date-part name="ye