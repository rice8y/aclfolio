<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-GB" version="1.0" class="in-text" initialize-with-hyphen="true" page-range-format="minimal" demote-non-dropping-particle="sort-only"><info><author><name>Sebastian Karcher</name></author><category citation-format="numeric"/><category field="medicine"/><id>http://www.zotero.org/styles/the-lancet</id><issn>0099-5355</issn><eissn>1474-547X</eissn><link href="http://www.zotero.org/styles/the-lancet" rel="self"/><link href="http://www.zotero.org/styles/bmj" rel="template"/><link href="http://download.thelancet.com/flatcontentassets/authors/lancet-information-for-authors.pdf" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>Vancouver style adapted for The Lancet</summary><title>The Lancet</title><updated>2012-09-27T22:06:38+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout vertical-align="sup" delimiter=","><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" second-field-align="flush" line-spacing="1" entry-spacing="1" subsequent-author-substitute-rule="complete-all" et-al-min="7" et-al-use-first="3"><layout suffix="."><text variable="citation-number" form="long" quotes="false" strip-periods="false"/><text macro="author" quotes="false" strip-periods="false"/><text macro="title" suffix=". " quotes="false" strip-periods="false"/><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group prefix=" " delimiter=" "><text macro="publisher" quotes="false" strip-periods="false"/></group></if><else-if type="chapter paper-conference" match="any"><group prefix=" " suffix=". "><text term="in" form="long" plural="false" suffix=": " quotes="false" strip-periods="false" text-case="capitalize-first"/><text macro="editor" quotes="false" strip-periods="false"/><group delimiter=", "><text variable="container-title" form="long" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/></group></group><group prefix=" " suffix="." delimiter=": "><text macro="publisher" quotes="false" strip-periods="false"/><text variable="page" form="long" suffix="." quotes="false" strip-periods="false"/></group></else-if><else><text macro="journal-title" quotes="false" strip-periods="false"/><group suffix="."><date variable="issued" prefix=" "><date-part name="year" strip-periods="false"/></date><choose><if variable="page volume" match="none"><date variable="issued" prefix="; published online " delimiter=" "><date-part name="month" form="short" strip-periods="true"/><date-part name="day" strip-periods="false"/></date></if></choose><group prefix="; "><text variable="volume" form="long" font-weight="bold" quotes="false" strip-periods="false"/><text variable="page" form="long" prefix=": " quotes="false" strip-periods="false"/></group></group></else></choose><text macro="access" prefix=" " quotes="false" strip-periods="false"/></layout></bibliography><macro name="author"><names variable="author" suffix=". "><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " strip-periods="false"/><et-al term="et al" font-style="italic"/><substitute><names variable="editor"/></substitute></names></macro><macro name="editor"><names variable="editor" suffix=". "><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="short" plural="contextual" prefix=", " strip-periods="false"/><et-al term="et al" font-style="italic"/></names></macro><macro name="publisher"><group delimiter=", "><group delimiter=": "><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group><date variable="issued"><date-part name="year" strip-periods="false"/></date></group></macro><macro name="access"><choose><if variable="page" match="none"><choose><if variable="DOI" match="all"><text variable="DOI" form="long" prefix=" DOI:" quotes="false" strip-periods="false"/></if><else-if variable="URL" match="all"><text variable="URL" form="long" quotes="false" strip-periods="false"/><group prefix=" (" suffix=")." delimiter=" "><text term="accessed" form="long" plural="false" quotes="false" strip-periods="false"/><date variable="accessed" form="text"/></group></else-if></choose></if></choose></macro><macro name="journal-title"><choose><if type="article-journal article-magazine" match="any"><text variable="container-title" form="short" font-style="italic" quotes="false" strip-periods="true"/></if><else><text variable="container-title" form="short" suffix=". " quotes="false" strip-periods="false"/></else></choose></macro><macro name="title"><choose><if type="book" match="all"><group delimiter=", "><text variable="title" form="long" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/></group></if><else><text variable="title" form="long" quotes="false" strip-periods="false"/></else></choose></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><locale><terms><term name="edition" form="short">edn.</term><term name="month-01" form="short">Jan.</term><term name="month-02" form="short">Feb.</term><term name="month-03" form="short">March</term><term name="month-04" form="short">April</term><term name="month-05" form="short">May</term><term name="month-06" form="short">June</term><term name="month-07" form="short">July</term><term name="month-08" form="short">Aug.</term><term name="month-09" form="short">Sept.</term><term name="month-10" form="short">Oct.</term><term name="month-11" form="short">Nov.</term><term name="month-12" form="short">Dec.</term></terms><date form="text"><date-part name="month" form="short" suffix=" " strip-periods="true"/><date-part name="day" suffix=", " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></locale></style>