ariable="title" match="none"><choose><if type="personal_communication" match="none"><text variable="genre" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/></if></choose></if><else-if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></else-if><else><text variable="title" form="long" quotes="true" strip-periods="false" text-case="title"/></else></choose></macro><macro name="title-short"><choose><if variable="title" match="none"><choose><if type="interview" match="all"><text term="interview" form="long" plural="false" quotes="false" strip-periods="false"/></if><else-if type="manuscript speech" match="any"><text variable="genre" form="short" quotes="false" strip-periods="false"/></else-if><else-if type="personal_communication" match="all"><text macro="issued" quotes="false" strip-periods="false"/></else-if></choose></if><else-if type="bill book graphic legal_case legislation motion_picture report song" match="any"><text variable="title" form="short" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></else-if><else><text variable="title" form="short" quotes="true" strip-periods="false" text-case="title"/></else></choose></macro><macro name="description-note"><group delimiter=", "><text macro="interviewer-note" quotes="false" strip-periods="false"/><text variable="medium" form="long" quotes="false" strip-periods="false"/><choose><if variable="title" match="none"/><else-if type="thesis speech" match="any"/><else><text variable="genre" form="long" quotes="false" strip-periods="false"/></else></choose></group></macro><macro name="description"><group delimiter=", "><group delimiter=". "><text macro="interviewer" quotes="false" strip-periods="false"/><text variable="medium" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/></group><choose><if variable="title" match="none"/><else-if type="thesis speech" match="any"/><else><text variable="genre" form="long" quotes="false" strip-periods="false" text-case="capitalize-first"/></else></choose></group></macro><macro name="container-title-note"><choose><if type="chapter paper-conference" match="any"><text term="in" form="long" plural="false" suffix=" " quotes="false" strip-periods="false"/></if></choose><choose><if type="legal_case" match="none"><choose><if type="article-journal article-magazine" match="none"><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></if><else><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/></else></choose></if></choose></macro><macro name="container-title"><choose><if type="chapter paper-conference" match="any"><text term="in" form="long" plural="false" suffix=" " quotes="false" strip-periods="false" text-case="capitalize-first"/></if></choose><choose><if type="legal_case" match="none"><choose><if type="article-journal article-magazine" match="none"><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false" text-case="title"/></if><else><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/></else></choose></if></choose></macro><macro name="collection-title"><text variable="collection-title" form="long" quotes="false" strip-periods="false"/><text variable="collection-number" form="long" prefix=" " quotes="false" strip-periods="false"/></macro><macro name="edition-note"><choose><if type="bill book chapter graphic legal_case legislation motion_picture paper-conference report song" match="any"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false"/></group></if><else><text variable="edition"