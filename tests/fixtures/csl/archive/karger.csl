<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" page-range-format="minimal" demote-non-dropping-particle="sort-only"><info><author><name>Sebastian Karcher</name></author><contributor><name>Sean Takats</name><email>stakats@gmu.edu</email></contributor><contributor><name>Michael Berkowitz</name><email>mberkowi@gmu.edu</email></contributor><contributor><name>Patrick O'Brien</name><email>citationstyler@gmail.com</email></contributor><category citation-format="numeric"/><category field="science"/><id>http://www.zotero.org/styles/karger-journals</id><link href="http://www.zotero.org/styles/karger-journals" rel="self"/><link href="http://www.karger.com/Journal/Guidelines/223832#05" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>Vancouver style for Journals published by Karger</summary><title>Karger journals</title><updated>2019-07-08T19:49:43+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="false" collapse="citation-number" near-note-distance="5"><sort><key variable="citation-number" sort="ascending"/></sort><layout prefix="[" suffix="]" delimiter=","><text variable="citation-number" form="long" quotes="false" strip-periods="false"/></layout></citation><bibliography hanging-indent="false" second-field-align="flush" line-spacing="1" entry-spacing="1" subsequent-author-substitute-rule="complete-all" et-al-min="7" et-al-use-first="6"><layout><text variable="citation-number" form="long" suffix=" " quotes="false" strip-periods="false"/><group delimiter=". "><text macro="author" quotes="false" strip-periods="false"/><text macro="title" quotes="false" strip-periods="false"/><choose><if type="bill book graphic legal_case legislation motion_picture report song" match="any"><group suffix="." delimiter=". "><text macro="edition" quotes="false" strip-periods="false"/><text macro="publisher" quotes="false" strip-periods="false"/></group></if><else-if type="chapter paper-conference" match="any"><group delimiter=". "><group delimiter=": "><text term="in" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text macro="editor" quotes="false" strip-periods="false"/></group><text variable="container-title" form="long" quotes="false" strip-periods="false"/><text macro="edition" prefix=", " quotes="false" strip-periods="false"/></group><group suffix="." delimiter="; "><text macro="publisher" quotes="false" strip-periods="false"/><group delimiter=" "><label variable="page" form="short" plural="contextual" strip-periods="true"/><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></else-if><else><group delimiter=". "><text variable="container-title" form="short" quotes="false" strip-periods="true"/><group delimiter=";"><group><date variable="issued"><date-part name="year" strip-periods="false"/><date-part name="month" form="short" prefix=" " strip-periods="true"/></date><text macro="accessed-date" prefix=" " suffix=". " quotes="false" strip-periods="false"/></group><group suffix=". " delimiter=":"><group><text variable="volume" form="long" quotes="false" strip-periods="false"/><text variable="issue" form="long" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group><text variable="page" form="long" quotes="false" strip-periods="false"/></group></group></group></else></choose></group><text macro="access" quotes="false" strip-periods="false"/></layout></bibliography><macro name="author"><names variable="author"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " strip-periods="true"/><substitute><names variable="editor"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="editor"><names variable="editor"><name delimiter=", " delimiter-precedes-last="always" initialize-with="" name-as-sort-order="all" sort-separator=" "/><label form="long" plural="contextual" prefix=", " strip-periods="false"/></names></macro><macro name="publisher"><group delimiter="; "><group delimiter=": "><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group><date variable="issued"><date-part name="year" strip-periods="false"/></date><text macro="accessed-date" prefix=" " quotes="false" strip-periods="false"/></group></macro><macro name="access"><choose><if variable="page" match="all"/><else-if variable="DOI" match="all"><text variable="DOI" form="long" prefix=" DOI: " quotes="false" strip-periods="false"/></else-if><else-if variable="URL" match="all"><group delimiter=": "><text term="available at" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="URL" form="long" quotes="false" strip-periods="false"/></group></else-if></choose></macro><macro name="accessed-date"><choose><if variable="DOI" match="all"/><else-if variable="URL" match="all"><group prefix="[" suffix="]" delimiter=" "><text term="cited" form="long" plural="false" quotes="false" strip-periods="false"/><date variable="accessed"><date-part name="year" strip-periods="false"/><date-part name="month" form="short" prefix=" " strip-periods="true"/><date-part name="day" prefix=" " strip-periods="false"/></date></group></else-if></choose></macro><macro name="title"><group delimiter=" "><text variable="title" form="long" quotes="false" strip-periods="false"/><choose><if type="webpage post post-weblog" match="any"><text term="internet" form="long" plural="false" prefix="[" suffix="]" quotes="false" strip-periods="false" text-case="capitalize-first"/></if></choose></group></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="true"/></group></if><else><text variable="edition" form="long" quotes="false" strip-periods="false"/></else></choose></macro><locale xml:lang="en"><terms><term name="available at" form="long">available from</term></terms></locale></style>