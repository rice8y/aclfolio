<style xmlns="http://purl.org/net/xbiblio/csl" default-locale="en-US" version="1.0" class="in-text" initialize-with-hyphen="true" demote-non-dropping-particle="never"><info><author><name>Sebastian Karcher</name></author><contributor><name>Julian Onions</name><email>julian.onions@gmail.com</email></contributor><contributor><name>Patrick O'Brien</name></contributor><category citation-format="author-date"/><category field="generic-base"/><id>http://www.zotero.org/styles/frontiers</id><link href="http://www.zotero.org/styles/frontiers" rel="self"/><link href="https://www.frontiersin.org/guidelines/author-guidelines" rel="documentation"/><rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights><summary>Style for the Open Access Frontiers in ... Journals</summary><title>Frontiers journals</title><updated>2024-02-20T20:07:43+00:00</updated></info><citation disambiguate-add-givenname="false" givenname-disambiguation-rule="by-cite" disambiguate-add-names="false" disambiguate-add-year-suffix="true" collapse="year" near-note-distance="5" et-al-min="3" et-al-use-first="1"><sort><key macro="year-date" sort="ascending"/><key macro="author-short" sort="ascending"/></sort><layout prefix="(" suffix=")" delimiter="; "><group delimiter=", "><text macro="author-short" quotes="false" strip-periods="false"/><text macro="year-date" quotes="false" strip-periods="false"/><group delimiter=" "><label variable="locator" form="short" plural="contextual" strip-periods="false"/><text variable="locator" form="long" quotes="false" strip-periods="false"/></group></group></layout></citation><bibliography hanging-indent="true" line-spacing="1" entry-spacing="1" subsequent-author-substitute-rule="complete-all" et-al-min="7" et-al-use-first="6"><sort><key macro="author" sort="ascending"/><key macro="year-date" sort="ascending"/><key variable="title" sort="ascending"/></sort><layout><group suffix="." delimiter=" "><text macro="author" quotes="false" strip-periods="false"/><text macro="year-date" prefix="(" suffix=")." quotes="false" strip-periods="false"/><choose><if type="bill book graphic legal_case legislation motion_picture report song thesis" match="any"><group delimiter=". "><group delimiter=", "><text macro="title" quotes="false" strip-periods="false"/><text macro="edition" quotes="false" strip-periods="false"/><text macro="editor" quotes="false" strip-periods="false"/></group><text macro="publisher" quotes="false" strip-periods="false"/></group></if><else-if type="chapter paper-conference" match="any"><group delimiter=", "><text macro="title" quotes="false" strip-periods="false"/><group delimiter=" "><text term="in" form="long" plural="false" quotes="false" strip-periods="false"/><text variable="container-title" form="long" font-style="italic" quotes="false" strip-periods="false"/></group><group delimiter=" "><text macro="editor" quotes="false" strip-periods="false"/><text macro="publisher" prefix="(" suffix=")" quotes="false" strip-periods="false"/></group><text variable="page" form="long" quotes="false" strip-periods="false"/></group></else-if><else><text macro="title" suffix="." quotes="false" strip-periods="false"/><group prefix=" " suffix="." delimiter=", "><group delimiter=" "><text variable="container-title" form="short" font-style="italic" quotes="false" strip-periods="false"/><text variable="volume" form="long" quotes="false" strip-periods="false"/></group><text variable="page" form="long" quotes="false" strip-periods="false"/></group></else></choose></group><text macro="access" prefix=" " quotes="false" strip-periods="false"/></layout></bibliography><macro name="editor"><names variable="editor" delimiter=", "><label form="short" plural="contextual" strip-periods="false"/><name delimiter=", " and="text" initialize-with=". " prefix=" "/></names></macro><macro name="author"><names variable="author"><name delimiter=", " and="text" delimiter-precedes-last="always" initialize-with=". " name-as-sort-order="all" sort-separator=", "/><label form="short" plural="contextual" prefix=" " strip-periods="false"/><substitute><names variable="editor"/><text variable="title" form="long" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="author-short"><names variable="author"><name delimiter=", " form="short" and="text" initialize-with=". "/><substitute><names variable="editor"/><names variable="translator"/><text variable="title" form="long" quotes="false" strip-periods="false"/></substitute></names></macro><macro name="access"><choose><if variable="DOI" match="all"><text variable="DOI" form="long" prefix="doi: " quotes="false" strip-periods="false"/></if><else-if variable="URL" match="all"><group delimiter=": "><text term="available at" form="long" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/><text variable="URL" form="long" quotes="false" strip-periods="false"/></group><group prefix=" (" suffix=")."><text term="accessed" form="long" plural="false" suffix=" " quotes="false" strip-periods="false" text-case="capitalize-first"/><date variable="accessed"><date-part name="month" suffix=" " strip-periods="false"/><date-part name="day" suffix=", " strip-periods="false"/><date-part name="year" strip-periods="false"/></date></group></else-if></choose></macro><macro name="title"><choose><if type="book" match="all"><text variable="title" form="long" font-style="italic" suffix="." quotes="false" strip-periods="false"/></if><else-if type="chapter" match="all"><text variable="title" form="long" suffix="," quotes="true" strip-periods="false"/></else-if><else><text variable="title" form="long" suffix="." quotes="false" strip-periods="false"/></else></choose></macro><macro name="publisher"><group delimiter=": "><text variable="publisher-place" form="long" quotes="false" strip-periods="false"/><text variable="publisher" form="long" quotes="false" strip-periods="false"/></group></macro><macro name="year-date"><choose><if variable="issued" match="any"><date variable="issued" form="numeric" date-parts="year"/></if><else><text term="no date" form="short" plural="false" quotes="false" strip-periods="false"/></else></choose></macro><macro name="edition"><choose><if is-numeric="edition" match="all"><group delimiter=" "><number variable="edition" form="ordinal"/><text term="edition" form="short" plural="false" quotes="false" strip-periods="false" text-case="capitalize-first"/></group></if><else><text variable="edition" form="long" quotes="false" strip-periods="false"/></else></choose></macro><locale xml:lang="en"><terms><term name="edition" form="short">edn</term></terms></locale></style>